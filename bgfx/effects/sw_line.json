// STAR WARS ベクター線描画用、解析的 AA エフェクト
{
	"blend": {
		"equation": "add",
		"srcColor": "srcalpha",
		"dstColor": "1",
		"srcAlpha": "srcalpha",
		"dstAlpha": "1"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_sw_line",
	"uniforms": [
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
		{ "name": "u_line_params",   "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] }
	]
}
