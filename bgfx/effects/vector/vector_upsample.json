// 9-tap tent upsample under pure ADD blend (srcColor=1, dstColor=1).
// Used by the Stage 2 ladder bloom's up passes (acc(n+1) -> acc(n)) instead of
// vector_blit_add's single bilinear tap, to suppress diamond/star artifacts from
// repeated bilinear up-adds.
// u_blit_intensity.x: contribution weight (the ladder up passes use 1.0)
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "1",
		"srcAlpha": "1",
		"dstAlpha": "1"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_upsample",
	"uniforms": [
		{ "name": "s_tex",             "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_blit_intensity",  "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_screen_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",   "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
