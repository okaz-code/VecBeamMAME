// Halation ring: annular gather of the half-res bright source into the ring target.
{
	"blend": { "equation": "add", "srcColor": "1", "dstColor": "0", "srcAlpha": "1", "dstAlpha": "0" },
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_halo_ring",
	"uniforms": [
		{ "name": "s_tex",            "type": "int",  "values": [ 0.0 ] },
		{ "name": "u_inv_screen_dims","type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
		{ "name": "u_ring_radius",    "type": "vec4", "values": [ 24.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_ring_gain",      "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_ring_gain2",     "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_ring_threshold", "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] }
	]
}
