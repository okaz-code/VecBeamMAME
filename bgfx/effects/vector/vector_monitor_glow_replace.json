// Monitor glow plus copy, using REPLACE blend. It is safe either as an in-place pass on a
// double-buffered target, or as a fused final blit from one target to a distinct output target.
// The colour phosphor chain uses the latter form to write screen_hdr without a second copy pass.
// Do not use it in-place on a single-buffer target.
// uniforms:
//   u_mglow_amount:     accumulated off-screen overload energy (injected each frame by the renderer)
//   u_mglow_brightness: overall brightness multiplier slider
//   u_mglow_edge_diff:  center-to-edge brightness difference slider
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_monitor_glow_replace",
	"uniforms": [
		{ "name": "s_tex",              "type": "int",  "values": [ 0.0 ] },
		{ "name": "u_mglow_amount",     "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_mglow_brightness", "type": "vec4", "values": [ 0.5, 0.0, 0.0, 0.0 ] },
		{ "name": "u_mglow_edge_diff",  "type": "vec4", "values": [ 0.5, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",    "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
