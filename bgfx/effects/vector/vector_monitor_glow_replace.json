// Monitor glow - full-screen radial glow added onto the base image IN THE SHADER (samples s_tex
// itself), so this writes internal in-place (replace blend) rather than relying on additive blend
// state onto a separate accumulation target - safe on the DOUBLEBUFFERED "internal" target only.
// Used by the current vector-color-phosphor.json chain. Do NOT point this at a single-buffer target
// (the older chains' "mglow_out") - see vector_monitor_glow.json (the plain additive-only sibling used
// by those chains) for why.
// uniforms:
//   u_mglow_amount:     accumulated off-screen overload energy (injected each frame by the renderer)
//   u_mglow_brightness: overall brightness multiplier slider
//   u_mglow_edge_diff:  center-to-edge brightness difference slider
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_monitor_glow_replace",
	"uniforms": [
		{ "name": "s_tex",              "type": "int",  "values": [ 0.0 ] },
		{ "name": "u_mglow_amount",     "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_mglow_brightness", "type": "vec4", "values": [ 0.5, 0.0, 0.0, 0.0 ] },
		{ "name": "u_mglow_edge_diff",  "type": "vec4", "values": [ 0.5, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",    "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
