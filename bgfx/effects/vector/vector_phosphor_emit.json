// Colour phosphor-decay pool, EMIT pass. Reads the pool (rgb=peak, a=age) and outputs peak * S(age).
// u_phos = (dt_ms, half_ms, curve, total_ms); only half/curve/total are used here.
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_phosphor_emit",
	"uniforms": [
		{ "name": "s_tex",           "type": "int",  "values": [ 0.0 ] },
		{ "name": "u_phos",          "type": "vec4", "values": [ 0.0, 42.0, 1.2, 500.0 ] },
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
