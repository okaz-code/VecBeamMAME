// Vector glow pyramid downsample (4-tap box or 13-tap tent; see fs_vector_downsample.sc).
// The chain system sets u_inv_screen_dims automatically from the first input texture size.
// No u_ds_params injection from C++ is needed (the shader uses u_inv_screen_dims * 0.5).
// The defaults below are the exact previous behaviour: legacy box kernel, no tonal reshape. A chain
// opts in per pass (u_glow_curve / u_glow_pivot on the first level only, u_ds_kernel on every level).
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_downsample",
	"uniforms": [
		{ "name": "s_tex",             "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_inv_screen_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
		{ "name": "u_glow_curve",      "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_glow_pivot",      "type": "vec4", "values": [ 0.25, 0.0, 0.0, 0.0 ] },
		{ "name": "u_ds_kernel",       "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] }
	]
}
