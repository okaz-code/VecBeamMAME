// Colour phosphor-decay pool, UPDATE pass. Pool stores rgb = peak colour, a = age (ms).
// u_phos = (dt_ms, half_ms, curve, total_ms). Reads s_prev (pool) + s_tex (fresh frame), writes pool.
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_phosphor",
	"uniforms": [
		{ "name": "s_prev",          "type": "int",  "values": [ 0.0 ] },
		{ "name": "s_tex",           "type": "int",  "values": [ 1.0 ] },
		{ "name": "s_overlap",       "type": "int",  "values": [ 3.0 ] },
		{ "name": "s_prev_age",     "type": "int",  "values": [ 2.0 ] },
		{ "name": "u_phos",          "type": "vec4", "values": [ 0.0, 42.0, 1.2, 500.0 ] },
		{ "name": "u_phos2",         "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_phos_rgb",      "type": "vec4", "values": [ 1.0, 1.0, 1.0, 0.0 ] },
		{ "name": "u_phos_reset",    "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_phos_composite","type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_phos_peak",     "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_phos_radiant",  "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_overlap_white_strength",   "type": "vec4", "values": [ 0.8, 0.0, 0.0, 0.0 ] },
		{ "name": "u_overlap_white_brightness", "type": "vec4", "values": [ 0.5, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
