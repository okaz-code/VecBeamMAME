// Analytic gaussian line integral renderer (erf closed form). Replaces the
// classic quad+cap-fan vector_line when -bgfx_vec_line_shader analytic is set.
// Per-line data (axial distances, perpendicular distance, sigma) rides the
// vertices as a 4-component TEXCOORD1; ADD blend as the classic path.
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "1",
		"srcAlpha": "srcalpha",
		"dstAlpha": "1"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vector/vs_vector_line_analytic",
	"fragment": "vector/fs_vector_line_analytic",
	"uniforms": [
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
		{
      "name": "u_halo_quad_edge",
      "type": "vec4",
      "values": [
        0.0021874911,
        1.0021922,
        0.0,
        0.0
      ]
    },
    { "name": "u_line_params",   "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
    { "name": "u_core_dwell",    "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] }
	]
}
