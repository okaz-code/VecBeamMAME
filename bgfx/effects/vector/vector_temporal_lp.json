// Temporal low-pass (exponential moving average) of the final image for flicker reduction.
// out = mix(cur, prev, u_smooth_k.x).
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_temporal_lp",
	"uniforms": [
		{ "name": "s_prev",          "type": "int",  "values": [ 0.0 ] },
		{ "name": "s_tex",           "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_smooth_k",      "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
