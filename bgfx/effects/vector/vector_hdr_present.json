// Encode the composed HDR work target for the backbuffer (PQ for HDR10, gamma for SDR).
{
	"blend": { "equation": "add", "srcColor": "1", "dstColor": "0", "srcAlpha": "1", "dstAlpha": "0" },
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_hdr_present",
	"uniforms": [
		{ "name": "s_tex",           "type": "int",  "values": [ 0.0 ] },
		{ "name": "u_hdr_params",    "type": "vec4", "values": [ 1000.0, 200.0, 1.0, 0.0 ] },
		{ "name": "u_hdr_rolloff",   "type": "vec4", "values": [ 1.0, 1.3, 0.0, 0.0 ] },
		{ "name": "u_sdr_rolloff",   "type": "vec4", "values": [ 1.0, 1.0, 1.0, 0.0 ] },
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
