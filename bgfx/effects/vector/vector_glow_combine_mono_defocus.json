// Monochrome-vector post-phosphor defocus, asymmetric pincushion, ambient,
// and calibrated glow composite in one replace pass. No shadow-mask sample.
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "vector/fs_vector_glow_combine_mono_defocus",
	"uniforms": [
		{ "name": "s_base",                           "type": "int",  "values": [ 0.0 ] },
		{ "name": "s_bloom",                          "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_defocus",                        "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_x_quad",          "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_x_cubic",         "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_y_quad",          "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_y_cubic",         "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_glow_enable",                    "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_ambient_color",                   "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_ambient_level",                   "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",                   "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
