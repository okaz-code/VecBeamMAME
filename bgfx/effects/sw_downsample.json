// license:BSD-3-Clause
// 4タップ bilinear ボックス downsample
// u_inv_screen_dims は chain system が第1入力テクスチャ寸法から自動セット。
// C++ からの u_ds_params injection は不要（シェーダが u_inv_screen_dims * 0.5 を使用）。
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_sw_downsample",
	"uniforms": [
		{ "name": "s_tex",             "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_inv_screen_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
