// HLSL bloom.fx 互換の最終 bloom 合成 (base + bloom + overdrive cross-talk)。
// REPLACE blend、s_base + s_bloom の 2 sampler 入力。
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_sw_bloom_apply",
	"uniforms": [
		{ "name": "s_base",              "type": "int",  "values": [ 0.0 ] },
		{ "name": "s_bloom",             "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_bloom_base_weight", "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_bloom_scale",       "type": "vec4", "values": [ 0.75, 0.0, 0.0, 0.0 ] },
		{ "name": "u_bloom_overdrive",   "type": "vec4", "values": [ 1.0, 1.0, 1.0, 0.0 ] },
		{ "name": "u_bloom_channel_gain","type": "vec4", "values": [ 1.0, 1.0, 1.0, 0.0 ] },
		{ "name": "u_time",              "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",     "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
