// v3: 3x3 color matrix (u_red_mix/u_green_mix/u_blue_mix) + post-mix gain。
// vector-starwars / vector-color / vector-monochrome 全 chain で最終段に配置。
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_sw_color_mix",
	"uniforms": [
		{ "name": "s_tex",                "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_red_mix",            "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_green_mix",          "type": "vec4", "values": [ 0.0, 1.0, 0.0, 0.0 ] },
		{ "name": "u_blue_mix",           "type": "vec4", "values": [ 0.0, 0.0, 1.0, 0.0 ] },
		{ "name": "u_line_channel_gain",  "type": "vec4", "values": [ 1.0, 1.0, 1.0, 0.0 ] },
		{ "name": "u_inv_view_dims",      "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
