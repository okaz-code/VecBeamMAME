// Asymmetric pincushion distortion specific to vector CRTs.
// REPLACE blend; distorts s_tex asymmetrically and writes to output.
// u_vec_pincushion_x.xy = (quad, cubic) X-axis deformation amount
// u_vec_pincushion_y.xy = (quad, cubic) Y-axis deformation amount
// All defaults 0 = identity (no distortion).
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_vector_distortion",
	"uniforms": [
		{ "name": "s_tex",               "type": "int",  "values": [ 0.0 ] },
		{ "name": "u_vec_pincushion_x_quad",  "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_x_cubic", "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_y_quad",  "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_vec_pincushion_y_cubic", "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",     "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
