// Two-component phosphor decay, slow component (P31 comet tail).
// Overwrites the slow pool with: pool_prev * u_tail_decay.x + current image.
// u_tail_freeze.x (injected by the renderer) holds the pool while emulation
// time is not advancing (pause), so the tail neither decays nor pumps up.
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "0",
		"srcAlpha": "1",
		"dstAlpha": "0"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_vector_phosphor_tail",
	"uniforms": [
		{ "name": "s_prev",          "type": "int",  "values": [ 0.0 ] },
		{ "name": "s_tex",           "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_tail_decay",    "type": "vec4", "values": [ 0.90, 0.0, 0.0, 0.0 ] },
		{ "name": "u_tail_freeze",   "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
