// STAR WARS glow用、可分ガウシアンブラーエフェクト
// uniforms:
//   u_inv_screen_dims: 入力テクスチャ寸法の逆数（chain system が自動セット）
//   u_blur_dir:        方向ベクトル。水平 = (1, 0, 0, 0)、垂直 = (0, 1, 0, 0)。
//                      vector-starwars.json の per-pass uniforms で上書き。
//   u_blur_width:      Halo Width slider (default 1.0)。タップ間隔倍率。
//   u_blur_strength:   Halo Strength slider (default 1.5)。出力輝度乗算。
{
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_sw_blur",
	"uniforms": [
		{ "name": "s_tex",             "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_inv_screen_dims", "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] },
		{ "name": "u_blur_dir",        "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_blur_width",      "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_blur_strength",   "type": "vec4", "values": [ 1.5, 1.5, 1.5, 0.0 ] }
	]
}
