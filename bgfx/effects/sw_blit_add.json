// Pure additive blit (srcalpha 補正なし)
// gui_add は srcColor=srcalpha で output_alpha が contribution に掛かる仕様。
// phosphor では texture × decay (頂点色) をそのまま add したいので、
// alpha 補正なしの pure additive (srcColor=1, dstColor=1) で実装。
// u_blit_intensity.x: Glow Blit Intensity slider (default 1.0)
{
	"blend": {
		"equation": "add",
		"srcColor": "1",
		"dstColor": "1",
		"srcAlpha": "1",
		"dstAlpha": "1"
	},
	"depth": { "function": "always" },
	"cull": { "mode": "none" },
	"write": { "rgb": true, "alpha": true },
	"vertex": "vs_gui",
	"fragment": "fs_sw_blit_add",
	"uniforms": [
		{ "name": "s_tex",             "type": "int",  "values": [ 1.0 ] },
		{ "name": "u_blit_intensity",  "type": "vec4", "values": [ 1.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_bloom_overdrive", "type": "vec4", "values": [ 0.0, 0.0, 0.0, 0.0 ] },
		{ "name": "u_inv_view_dims",   "type": "vec4", "values": [ 1.0, 1.0, 0.0, 0.0 ] }
	]
}
