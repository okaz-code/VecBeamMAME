	"parameters": [
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{ "name": "internal",  "mode": "native", "scale": 1, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "glow_accum", "mode": "native", "scale": 0.5, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "Half-resolution accumulator matching the renderer glow FBO. The full-resolution beam and phosphor pool remain untouched; Glow Combine upsamples this smooth light field." },
		{ "name": "overlap_field0", "mode": "native", "scale": 0.5, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "Half-resolution direct overlap-white Alpha field." },
		{ "name": "overlap_field1", "mode": "native", "scale": 0.5, "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "phos_pool", "mode": "native", "scale": 1, "doublebuffer": true, "format": "RGBA16F",
		  "_comment": "phosphor pool: rgb = peak excitation colour, a = age (ms). Held + decayed by S(age). RGBA16F so age fits in alpha and colour is preserved (mono now, imager/AVG colour later)." },

		{ "name": "screen_hdr","mode": "native", "scale": 1, "doublebuffer": false, "format": "RG11B10F",
		  "_comment": "linear chain output; its presence makes the renderer present this as an HDR chain (PQ/EDR, SDR fallback)" },
		{ "name": "glow_lo0", "mode": "native", "scale": 0.5,     "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "wide local glow: the per-line glow buffer cascaded down to 1/64, then upscaled+added. The deep level supplies an approximately 100px-class far halo while the shared analytic source and narrow glow remain unchanged." },
		{ "name": "glow_lo1", "mode": "native", "scale": 0.25,    "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo2", "mode": "native", "scale": 0.125,   "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo3", "mode": "native", "scale": 0.0625,  "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo4", "mode": "native", "scale": 0.03125, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "Wide-glow extension only: low-cost intermediate level; does not affect the narrow seed." },
		{ "name": "glow_lo5", "mode": "native", "scale": 0.015625,"doublebuffer": false, "format": "RGBA16F",
		  "_comment": "Deepest Wide-only level. At 4K this is only about 60x34 pixels, so its fill and memory cost are negligible." },
		{ "name": "glow_lo5b", "mode": "native", "scale": 0.015625,"doublebuffer": false, "format": "RGBA16F",
		  "_comment": "Ping-pong scratch for the optional deep-level blur (Glow Wide Downsample = Tent + deep blur). Same 60x34 size, so the two extra passes are ~4k pixels each." }
	],

	"passes": [
		{ "effect": "vector/vector_linearize", "name": "Initial Blit (linearize, screen -> internal)",
		  "_comment": "A4: guest and the identity same-scale Prescale copy are removed; linearize writes directly to the full-resolution RG11B10F internal ping-pong target.",
		  "input": [ { "sampler": "s_tex", "texture": "screen" } ], "output": "internal" },

		{   "effect": "hlsl/deconverge",
			"name": "Deconvergence",
			"_comment": "electron-gun misalignment (linear + radial per-channel offset). Placed after source linearization/optional colour convolution and BEFORE the phosphor pool/chroma mode: convergence is a property of THIS frame's raw RGB signal (misaimed guns), decided before the pool judges what's lit and before any colour-science/geometry passes touch it.",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_red",          "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_green",        "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_blue",         "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_red",   "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_green", "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_blue",  "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_converge_red",          "slider": "converge_red"   },
				{ "uniform": "u_converge_green",        "slider": "converge_green" },
				{ "uniform": "u_converge_blue",         "slider": "converge_blue"  },
				{ "uniform": "u_radial_converge_red",   "slider": "radial_converge_red"   },
				{ "uniform": "u_radial_converge_green", "slider": "radial_converge_green" },
				{ "uniform": "u_radial_converge_blue",  "slider": "radial_converge_blue"  }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},

		{ "effect": "vector/vector_overlap_white_extract", "name": "Overlap White Extract",
		  "input": [ { "sampler": "s_tex", "texture": "overlap" } ],
		  "uniforms": [ { "uniform": "u_overlap_white_count", "slider": "overlap_white_count" } ],
		  "output": "overlap_field0" },

		{ "effect": "vector/vector_overlap_white_blur", "name": "Overlap White Blur X",
		  "input": [ { "sampler": "s_tex", "target": "overlap_field0" } ],
		  "uniforms": [
			{ "uniform": "u_overlap_blur_direction", "value": [ 1.0, 0.0 ] },
			{ "uniform": "u_overlap_white_spread", "slider": "overlap_white_spread" } ],
		  "output": "overlap_field1" },

		{ "effect": "vector/vector_overlap_white_blur", "name": "Overlap White Blur Y",
		  "input": [ { "sampler": "s_tex", "target": "overlap_field1" } ],
		  "uniforms": [
			{ "uniform": "u_overlap_blur_direction", "value": [ 0.0, 1.0 ] },
			{ "uniform": "u_overlap_white_spread", "slider": "overlap_white_spread" } ],
		  "output": "overlap_field0" },

		{ "effect": "vector/vector_phosphor", "name": "Phosphor",
		  "_comment": "pool update: rgb=peak,a=age. A fresh hit above phosphor_hit_reset replaces the old pixel and resets age even when dimmer than its residue; below the floor, the legacy brighter-than-decayed test prevents gaussian tails from erasing adjacent afterglow. u_phos = (dt_ms, half, curve, total) is injected by the renderer. Reads+writes phos_pool in place (doublebuffered feedback).",
		  "input": [ { "sampler": "s_prev", "target": "phos_pool" }, { "sampler": "s_tex", "target": "internal" }, { "sampler": "s_overlap", "target": "overlap_field0" } ],
		  "uniforms": [
			{ "uniform": "u_phos_reset", "slider": "phosphor_hit_reset" },
			{ "uniform": "u_phos_composite", "slider": "phosphor_weak_hit_composite" },
			{ "uniform": "u_phos_radiant", "slider": "phosphor_rgb_combination" },
			{ "uniform": "u_overlap_white_strength", "slider": "overlap_white_strength" },
			{ "uniform": "u_overlap_white_brightness", "slider": "overlap_white_brightness" },
			{ "uniform": "u_phos_peak",  "slider": "masked_core_peak" } ], "output": "phos_pool" },

		{ "effect": "vector/vector_phosphor_compose_color", "name": "Phosphor Apply",
		  "_comment": "colour compose: pool emit + converged no-persist caps/dots + phosphor tint + CIE phosphor-to-sRGB conversion in one pass. This preserves the old ordering while removing the full-res npglow_dc target/pass and the following chroma pass. The entry name remains 'Phosphor Apply' for renderer u_phos injection.",
		  "input": [ { "sampler": "s_tex", "target": "phos_pool" }, { "sampler": "s_np", "texture": "npglow" }, { "sampler": "s_cur", "target": "internal" } ],
		  "uniforms": [ { "uniform": "u_np_gain",           "slider": "cap_no_persist" }, { "uniform": "u_phos_peak",         "slider": "masked_core_peak" }, { "uniform": "u_phos_radiant",      "slider": "phosphor_rgb_combination" }, { "uniform": "u_line_channel_gain", "slider": "phosphor_color" }, { "uniform": "u_converge_red",          "slider": "converge_red" }, { "uniform": "u_converge_green",        "slider": "converge_green" }, { "uniform": "u_converge_blue",         "slider": "converge_blue" }, { "uniform": "u_radial_converge_red",   "slider": "radial_converge_red" }, { "uniform": "u_radial_converge_green", "slider": "radial_converge_green" }, { "uniform": "u_radial_converge_blue",  "slider": "radial_converge_blue" }, { "uniform": "u_primary_mode",             "slider": "primary_color_mode" }, { "uniform": "u_primary_red_hue",          "slider": "primary_red_hue" }, { "uniform": "u_primary_red_saturation",   "slider": "primary_red_saturation" }, { "uniform": "u_primary_red_brightness",   "slider": "primary_red_brightness" }, { "uniform": "u_primary_green_hue",        "slider": "primary_green_hue" }, { "uniform": "u_primary_green_saturation", "slider": "primary_green_saturation" }, { "uniform": "u_primary_green_brightness", "slider": "primary_green_brightness" }, { "uniform": "u_primary_blue_hue",         "slider": "primary_blue_hue" }, { "uniform": "u_primary_blue_saturation",  "slider": "primary_blue_saturation" }, { "uniform": "u_primary_blue_brightness",  "slider": "primary_blue_brightness" }, { "uniform": "u_y_gain",   "slider": "chroma_y_gain" }, { "uniform": "u_chroma_a", "slider": "chroma_a" }, { "uniform": "u_chroma_b", "slider": "chroma_b" }, { "uniform": "u_chroma_c", "slider": "chroma_c" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_glow_accum", "name": "Glow Accum Narrow",
		  "_comment": "Stage 1 (narrow): one-tap seed of glow_accum (this pass keeps the default clear; the wide pass then adds into it). A 13-tap gaussian was tried here to band-limit the ~2.5x magnification of the glow FBO, but the square frame it was meant to remove turned out to be the analytic quads' 3.5-sigma truncation (fixed in fs_vector_line_analytic.sc), and 12 extra taps over the half-resolution accumulator is about 25M texture fetches per frame at 4K - the same order as switching the whole wide pyramid from box to tent. One tap it is.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "texture": "glow" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_narrow" } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds0", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "texture": "glow" } ],   "uniforms": [ { "uniform": "u_glow_curve", "slider": "glow_wide_curve" }, { "uniform": "u_glow_pivot", "slider": "glow_wide_pivot" }, { "uniform": "u_ds_kernel", "slider": "glow_wide_smooth" } ], "output": "glow_lo0" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds1", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ], "uniforms": [ { "uniform": "u_ds_kernel", "slider": "glow_wide_smooth" } ], "output": "glow_lo1" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds2", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "uniforms": [ { "uniform": "u_ds_kernel", "slider": "glow_wide_smooth" } ], "output": "glow_lo2" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds3", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "uniforms": [ { "uniform": "u_ds_kernel", "slider": "glow_wide_smooth" } ], "output": "glow_lo3" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds4", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "uniforms": [ { "uniform": "u_ds_kernel", "slider": "glow_wide_smooth" } ], "output": "glow_lo4" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds5", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo4" } ], "uniforms": [ { "uniform": "u_ds_kernel", "slider": "glow_wide_smooth" } ], "output": "glow_lo5" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_deep_blur_a",
		  "_comment": "Optional: two same-resolution 4-tap box passes on the deepest level. At 4K one glow_lo5 texel reconstructs to 64x64 output pixels, so its plateaus are what a very faint halo shows at its outer edge; pre-blurring it halves that residual structure (tools/glow-cascade-roundness.py).",
		  "disablewhen": [ { "type": "slider", "condition": "notequal", "name": "glow_wide_smooth", "value": 2.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "glow_lo5" } ], "output": "glow_lo5b" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_deep_blur_b",
		  "disablewhen": [ { "type": "slider", "condition": "notequal", "name": "glow_wide_smooth", "value": 2.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "glow_lo5b" } ], "output": "glow_lo5" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us4",
		  "_comment": "Glow Wide Reach weights only the coarsest 1/64 floor; normal Gaussian reconstruction keeps the halo smooth.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_wide_reach" } ], "output": "glow_lo4" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us3", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo3" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo2" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo1" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo0" },

		{ "effect": "vector/vector_blit_add", "name": "Glow Accum Wide",
		  "_comment": "Add the broad halo reconstructed from the 1/64 floor into the half-resolution glow accumulator.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_wide" } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_glow_combine_color_defocus", "name": "add_mglow",
		  "_comment": "Always-on final composite: unwarped/inset vector emission, dimension-correct selectable shadow mask on spherical tube coordinates, ambient plus mask-patterned monitor glow, phosphor-calibrated optical glow; writes screen_hdr directly and replaces the former extra monitor-glow pass.",
		  "input": [
			{ "sampler": "s_base",  "target": "internal" },
			{ "sampler": "s_bloom", "target": "glow_accum" },
			{ "sampler": "s_mask",  "option": "bgfx_shadow_mask", "selection": "Shadow Mask" },
			{ "sampler": "s_bezel_source", "texture": "glow" },
			{ "sampler": "s_bezel_length", "texture": "bezel_length" },
			{ "sampler": "s_flare", "texture": "flare" },
			{ "sampler": "s_overlap", "target": "overlap_field0" } ],
		  "uniforms": [ { "uniform": "u_defocus",                    "slider": "defocus" }, { "uniform": "u_vec_pincushion_x_quad",      "slider": "vector_pincushion_x_quad" }, { "uniform": "u_glow_enable",                "slider": "analytic_glow" }, { "uniform": "u_masked_flare_gain",          "slider": "overload_core_gain" }, { "uniform": "u_masked_core_peak",           "slider": "masked_core_peak" }, { "uniform": "u_overlap_white_strength",      "slider": "overlap_white_strength" }, { "uniform": "u_overlap_white_brightness",    "slider": "overlap_white_brightness" }, { "uniform": "u_shadow_mask_strength",        "slider": "shadow_mask_strength" }, { "uniform": "u_shadow_mask_brightboost",     "slider": "shadow_mask_brightboost" }, { "uniform": "u_shadow_mask_scale",           "slider": "shadow_mask_scale" }, { "uniform": "u_ambient_color",               "slider": "ambient_color" }, { "uniform": "u_ambient_level",               "slider": "ambient_level" }, { "uniform": "u_tube_distortion",       "slider": "tube_distortion" }, { "uniform": "u_tube_round_corner",     "slider": "tube_round_corner" }, { "uniform": "u_tube_vignetting",       "slider": "tube_vignetting" }, { "uniform": "u_tube_face_scale",       "slider": "tube_face_scale" }, { "uniform": "u_vector_image_scale",    "slider": "vector_image_scale" }, { "uniform": "u_bezel_glow_strength",   "slider": "bezel_glow_strength" }, { "uniform": "u_bezel_glow_width",      "slider": "bezel_glow_width" }, { "uniform": "u_bezel_glow_curve",      "slider": "bezel_glow_curve" }, { "uniform": "u_monitor_bezel_reflection", "slider": "monitor_bezel_reflection" }, { "uniform": "u_bezel_long_reflection", "slider": "bezel_long_reflection" }, { "uniform": "u_bezel_short_reflection", "slider": "bezel_short_reflection" }, { "uniform": "u_bezel_long_threshold", "slider": "bezel_long_threshold" }, { "uniform": "u_glow_tail_curve",       "slider": "glow_tail_curve" }, { "uniform": "u_ambient_mask",                "slider": "ambient_mask" }, { "uniform": "u_mglow_brightness",            "slider": "mglow_brightness" }, { "uniform": "u_mglow_edge_diff",             "slider": "mglow_center_edge_diff" }, { "uniform": "u_mglow_rgb_bands",              "slider": "mglow_rgb_bands" }, { "uniform": "u_mglow_rgb_band_count",         "slider": "mglow_rgb_band_count" }, { "uniform": "u_primary_mode",             "slider": "primary_color_mode" }, { "uniform": "u_primary_red_hue",          "slider": "primary_red_hue" }, { "uniform": "u_primary_red_saturation",   "slider": "primary_red_saturation" }, { "uniform": "u_primary_red_brightness",   "slider": "primary_red_brightness" }, { "uniform": "u_primary_green_hue",        "slider": "primary_green_hue" }, { "uniform": "u_primary_green_saturation", "slider": "primary_green_saturation" }, { "uniform": "u_primary_green_brightness", "slider": "primary_green_brightness" }, { "uniform": "u_primary_blue_hue",         "slider": "primary_blue_hue" }, { "uniform": "u_primary_blue_saturation",  "slider": "primary_blue_saturation" }, { "uniform": "u_primary_blue_brightness",  "slider": "primary_blue_brightness" }, { "uniform": "u_y_gain",                      "slider": "chroma_y_gain" }, { "uniform": "u_chroma_a",                    "slider": "chroma_a" }, { "uniform": "u_chroma_b",                    "slider": "chroma_b" }, { "uniform": "u_chroma_c",                    "slider": "chroma_c" } ],
		  "output": "screen_hdr" }
	]
}
