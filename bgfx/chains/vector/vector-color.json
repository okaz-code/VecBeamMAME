// Canonical colour-vector chain: full-resolution beam/phosphor path with half-resolution analytic glow and a 1/16 wide-glow floor.
// Colour vector phosphor chain (AVG colour: Tempest / Star Wars / Major Havoc, Sega G80, Cinematronics colour) - the Vectrex phosphor engine
// ported to generic vector sources. Same pipeline: per-pixel phosphor pool (rgb=peak, a=age, Hill
// decay), flat-core analytic beam, overdrive hot-core + Overload Glow (bloom), analytic glow, HDR
// present with hue-preserving roll-off + saturated-colour protection. No screen bloom (the glow path
// replaced it); halation ring/starburst rays were removed from this chain (colour/AVG content reads
// better with just analytic glow + Overload Glow reach; monochrome/Vectrex keeps ring/starburst).
// Sources without driver-supplied beam_energy fall back to n = intensity; the unified Energy Model
// (energy_* sliders) derives the slow-sweep / dwelling-dot overdrive renderer-side from the per-segment
// timestamps (AVG / DVG / Cinematronics have them), replacing the old dwell_* brightness knobs.
// Line caps are unconditional here (cap_flags / RAMP termini are a Vectrex concept).
{
	"name": "Vector (Color, HDR)",
	"author": "okaz",
	"screen_type": "vector",
	"vector_engine": "analytic",

	"sliders": [
		// ---- [M] マクロ: 1本で複数の詳細パラメータを駆動する。基準は「対象がマクロに触られる前に
		//      持っていた値」なので、既定 1.0 / On では現状の校正値と完全に一致する。scale と enable は
		//      係数として合成されるので、詳細1本を2本のマクロで駆動できる（Edge Defocus は [M] Defocus
		//      で倍率、[M] Monitor/Glass Sim で 0/1 のゲート）。curve は [マクロ値, 対象値] の折れ線 ----
		{"type":"float","name":"macro_exposure","text":"[M] Beam Brightness","default":1.0,"min":0.25,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"beam_peak_nits","mode":"scale"},{"slider":"sdr_beam_level","mode":"scale"}]},
		{"type":"float","name":"macro_overload","text":"[M] Overload Amount","default":1.0,"min":0.0,"max":2.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"overload_threshold","mode":"curve","curve":[[0.0,4.0],[0.5,1.4],[1.0,1.0],[2.0,0.9]]},
		             {"slider":"intensity_overdrive","mode":"curve","curve":[[0.0,0.0],[1.0,1.0],[2.0,1.6]]},
		             {"slider":"overload_glow_gain","mode":"curve","curve":[[0.0,0.0],[1.0,1.06],[2.0,1.8]]}]},
		{"type":"float","name":"macro_bloom","text":"[M] Bloom Strength","default":0.8,"min":0.0,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"glow_wide","mode":"scale"},{"slider":"glow_narrow","mode":"scale"},{"slider":"analytic_glow","mode":"scale"}]},
		{"type":"float","name":"macro_beam_width","text":"[M] Beam Width","default":1.0,"min":0.25,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"beam_width_min","mode":"scale"},{"slider":"beam_width_max","mode":"scale"},{"slider":"overload_width_add","mode":"scale"}]},
		{"type":"float","name":"macro_point_size","text":"[M] Point Size","default":1.0,"min":0.25,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"point_width_scale","mode":"scale"}]},
		{"type":"float","name":"macro_point_bright","text":"[M] Point Brightness","default":1.0,"min":0.0,"max":2.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"point_brightness_scale","mode":"scale"}]},
		{"type":"float","name":"macro_defocus","text":"[M] Defocus","default":1.0,"min":0.0,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector",
		  "targets":[{"slider":"defocus","mode":"scale"},{"slider":"edge_defocus","mode":"scale"},{"slider":"overload_bloom","mode":"scale"}]},
