			"mode": "native", "scale": 0.0625,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc4",
			"mode": "native", "scale": 0.03125,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
