// CRT chain for monochrome vectors. Asteroids / Battlezone / Lunar Lander / Vectrex, etc.
//   Color Convolution's saturation is fixed at 0 to grayscale the input, then vector_color_mix tints
//   it to the phosphor color via the `phosphor_color` slider (default green).
//   No Color Matrix / Convergence / Chroma sliders. Bloom setup is identical to the Color version.
{
	"name": "Vector (Monochrome, HDR)",
	"author": "Ryan Holtz & ImJezze (original HLSL) / okaz (vector adaptation)",
	"screen_type": "vector",

	"sliders": [
		{ "type": "float", "name": "beam_width_min",            "text": "Beam Width Minimum",        "default": 2.0,  "min": 0.1,  "max": 5.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_width_max",            "text": "Beam Width Maximum",        "default": 3.0,  "min": 0.1,  "max": 20.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "intensity_clip_low",        "text": "Intensity Clip Low",         "default": 0.0,  "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
