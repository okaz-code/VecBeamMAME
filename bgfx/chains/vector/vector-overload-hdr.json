		{ "type": "float", "name": "vector_pincushion_y_quad",  "text": "Vector Pincushion Y (Quad)",  "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_y_cubic", "text": "Vector Pincushion Y (Cubic)", "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "shadow_mask_strength",    "text": "Shadow Mask Strength",          "default": 0.7,  "min": 0.0,  "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "shadow_mask_brightboost", "text": "Shadow Mask Brightness Boost",  "default": 0.0,  "min": 0.0,  "max": 2.0,  "step": 0.05,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "shadow_mask_scale",       "text": "Shadow Mask Scale (px @1080p)", "default": 4.0,  "min": 1.0,  "max": 8.0,  "step": 0.5,   "format": "%2.1f", "screen": "vector" },
		{ "type": "float", "name": "distortion",       "text": "Quadric Distortion Amount", "default": 0.20, "max": 2.00, "min": -2.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "cubic_distortion", "text": "Cubic Distortion Amount",   "default": 0.00, "max": 2.00, "min": -2.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "distort_corner",   "text": "Distorted Corner Amount",   "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "round_corner",     "text": "Rounded Corner Amount",     "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "smooth_border",    "text": "Smooth Border Amount",      "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vignetting",       "text": "Vignetting Amount",         "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "reflection",       "text": "Reflection Amount",         "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" }
	],

	"parameters": [
		{ "name": "jitter", "type": "frame", "period": 2 },
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{   "name": "smooth_pool",
			"_comment": "temporal low-pass (EMA) history of the final image; doublebuffered ping-pong, format matches the final image (mglow_out)",
			"mode": "native",
			"scale": 1,
			"doublebuffer": true,
			"format": "RG11B10F"
		},
		{   "name": "flicker_pool",
			"_comment": "max-persistence pool (asymmetric phosphor for flicker reduction); doublebuffered ping-pong, format matches internal",
			"mode": "native",
			"scale": 1,
			"doublebuffer": true,
			"format": "RG11B10F"
		},
		{   "name": "mglow_out",
			"_comment": "single-buffer target holding the monitor-glow-composited final image fed to the Final Blit (add_mglow cannot self-RW the doublebuffered internal). format must match internal so the HDR linear values are not clamped to 8-bit",
			"mode": "native",
			"scale": 1,
			"doublebuffer": false,
			"format": "RG11B10F"
		},
		{   "name": "screen_hdr",
			"_comment": "linear chain output sampled by the HDR composite (RG11B10F, window size)",
			"mode": "native", "scale": 1,
			"doublebuffer": false,
			"format": "RG11B10F"
		},
		{   "name": "guest",
			"mode": "native",
			"bilinear": false,
			"doublebuffer": true,
			"format": "RG11B10F"
		},
		{   "name": "internal",
			"_comment": "scale 1: process all full-screen passes at the window resolution",
			"mode": "native",
			"scale": 1,
			"doublebuffer": true,
			"format": "RG11B10F"
		},
		{   "name": "previous",
			"mode": "native",
			"scale": 1,
			"doublebuffer": true,
			"format": "RG11B10F"
		},
		{   "name": "acc0",
			"_comment": "Stage 2 ladder bloom accumulators (acc0..acc6, window-proportional pyramid via fractional scale). Each is seeded with bloom_lvl(n) x weight (implicit clear) then up-added from acc(n+1) with clear:{}; the repeated bilinear up-resampling smooths deeper levels progressively, replacing the old halo blur",
			"mode": "native", "scale": 0.5,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc1",
			"mode": "native", "scale": 0.25,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc2",
			"mode": "native", "scale": 0.125,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc3",
			"mode": "native", "scale": 0.0625,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc4",
			"mode": "native", "scale": 0.03125,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc5",
			"mode": "native", "scale": 0.015625,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "acc6",
			"mode": "native", "scale": 0.0078125,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "slow_pool",
			"_comment": "Two-component phosphor decay: slow-tail accumulator (P22: the red channel's ms-scale tail dominates in practice; the RGB pool keeps each line's own colour). Half-res float; the bilinear upscale at composite doubles as the physical blur",
			"mode": "native", "scale": 0.5,
			"doublebuffer": true,
			"format": "RGBA16F"
		}
	],

	"passes": [
		{   "effect": "vector/vector_linearize",
			"name": "Initial Blit (linearize, screen -> guest)",
			"_comment": "linear HDR chain: everything downstream operates on linear light",
			"input": [
				{ "sampler": "s_tex", "texture": "screen" }
			],
			"output": "guest"
		},
		{   "effect": "hlsl/color",
			"name": "Color Convolution",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_red_ratios", "slider": "red_ratios" },
				{ "uniform": "u_grn_ratios", "slider": "grn_ratios" },
				{ "uniform": "u_blu_ratios", "slider": "blu_ratios" },
				{ "uniform": "u_offset",     "slider": "offset"     },
				{ "uniform": "u_scale",      "slider": "scale"      },
				{ "uniform": "u_saturation", "slider": "saturation" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "guest" }
			],
			"output": "guest"
		},
		{   "effect": "hlsl/prescale",
			"name": "Prescale",
			"input": [
				{ "sampler": "s_tex", "target": "guest" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/deconverge",
			"name": "Deconvergence",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",           "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_red",          "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_green",        "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_blue",         "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_red",   "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_green", "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_blue",  "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_converge_red",          "slider": "converge_red"   },
				{ "uniform": "u_converge_green",        "slider": "converge_green" },
				{ "uniform": "u_converge_blue",         "slider": "converge_blue"  },
				{ "uniform": "u_radial_converge_red",   "slider": "radial_converge_red"   },
				{ "uniform": "u_radial_converge_green", "slider": "radial_converge_green" },
				{ "uniform": "u_radial_converge_blue",  "slider": "radial_converge_blue"  }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/defocus",
			"name": "Defocus Pass",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or", "name": "adjustments", "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "or", "name": "defocus",     "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_defocus", "slider": "defocus" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/post",
			"name": "Non-Bloom Post Pass",
			"_comment": "shadow mask is handled by a separate pass (vector_shadow_mask), so HLSL post's shadow uniforms are fixed at literal 0. This pass handles only floor / power / chroma",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",    "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "floor",          "value": [ 0, 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "power",          "value": [ 1, 1, 1 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "chroma_mode",    "value": 3 }
			],
			"uniforms": [
				{ "uniform": "u_shadow_tile_mode",       "value":  [ 0.0 ] },
				{ "uniform": "u_shadow_alpha",           "value":  [ 0.0 ] },
				{ "uniform": "u_shadow_count",           "value":  [ 1.0, 1.0 ] },
				{ "uniform": "u_shadow_uv",              "value":  [ 0.0, 0.0 ] },
				{ "uniform": "u_shadow_uv_offset",       "value":  [ 0.0, 0.0 ] },
				{ "uniform": "u_humbar_alpha",           "value":  [ 0.0 ] },
				{ "uniform": "u_humbar_hertz_rate",      "value":  [ 0.0 ] },
				{ "uniform": "u_floor",                  "slider": "floor" },
				{ "uniform": "u_power",                  "slider": "power" },
				{ "uniform": "u_chroma_mode",            "slider": "chroma_mode" },
				{ "uniform": "u_conversion_gain",        "slider": "chroma_conversion_gain" },
				{ "uniform": "u_time",                   "parameter": "time" }
			],
			"input": [
				{ "sampler": "s_tex",    "target": "internal" },
				{ "sampler": "s_shadow", "option": "bgfx_shadow_mask", "selection": "Shadow Mask" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/phosphor",
			"name": "Phosphor Decay",
			"_comment": "this pass's input is internal (lines only). Phosphor persistence accumulates only over lines (bloom is scattered light and inherently instantaneous). Even with phosphor=[0,0,0] the shader is identity (PrevY*0+CurrY=CurrY)",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_passthrough", "value": [ 0 ] },
				{ "uniform": "u_phosphor",    "slider": "phosphor" }
			],
			"input": [
				{ "sampler": "s_tex",  "target": "internal" },
				{ "sampler": "s_prev", "target": "previous" }
			],
			"output": "previous"
		},
		
		{
			"effect": "hlsl/chroma",
			"name": "Phosphor Chromaticity Conversion",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_y_gain",   "slider": "chroma_y_gain" },
				{ "uniform": "u_chroma_a", "slider": "chroma_a" },
				{ "uniform": "u_chroma_b", "slider": "chroma_b" },
				{ "uniform": "u_chroma_c", "slider": "chroma_c" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "previous" }
			],
			"output": "internal"
		},
		{   "effect": "vector/vector_distortion",
			"name": "Vector Pincushion Pass",
			"_comment": "apply pincushion before the shadow mask, matching the physical order: the beam deflection (pincushion) draws onto the phosphor, then the fixed mask grid sits on top (the reverse order would distort the mask grid itself)",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",              "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_quad",  "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_cubic", "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_y_quad",  "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_y_cubic", "value": 0.0 }
			],
			"uniforms": [
				{ "uniform": "u_vec_pincushion_x_quad",  "slider": "vector_pincushion_x_quad" },
				{ "uniform": "u_vec_pincushion_x_cubic", "slider": "vector_pincushion_x_cubic" },
				{ "uniform": "u_vec_pincushion_y_quad",  "slider": "vector_pincushion_y_quad" },
				{ "uniform": "u_vec_pincushion_y_cubic", "slider": "vector_pincushion_y_cubic" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "vector/vector_shadow_mask",
			"name": "Shadow Mask Pass",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",          "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "shadow_mask_strength", "value": 0.0 }
			],
			"input": [
				{ "sampler": "s_tex",  "target":  "internal" },
				{ "sampler": "s_mask", "texture": "bgfx/chains/crt-geom/aperture_1_2_bgr.png" }
			],
			"uniforms": [
				{ "uniform": "u_shadow_mask_strength",    "slider": "shadow_mask_strength" },
				{ "uniform": "u_shadow_mask_brightboost", "slider": "shadow_mask_brightboost" },
				{ "uniform": "u_shadow_mask_scale",       "slider": "shadow_mask_scale" }
			],
			"output": "internal"
		},

		{ "effect": "vector/vector_phosphor_max", "name": "Flicker Persist",
		  "_comment": "max-based persistence (rise instant, decay only): out = max(cur, prev*decay). Reduces inter-frame flicker without the trails / over-bright of the additive Phosphor Decay. flicker_persist 0 = off (bypassed)",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "flicker_persist", "value": 0.0 } ],
		  "input": [ { "sampler": "s_prev", "target": "flicker_pool" }, { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [ { "uniform": "u_persist_decay", "slider": "flicker_persist" } ],
		  "output": "internal" },
		{ "effect": "misc/blit", "name": "Flicker Persist Store",
		  "_comment": "store the de-flickered internal as next frame's persistence history (flicker_pool is doublebuffered)",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "flicker_persist", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "internal" } ],
		  "output": "flicker_pool" },
		{   "effect": "vector/vector_phosphor_tail",
			"name": "tail_accum",
			"_comment": "Two-component phosphor decay, slow component: slow_pool = slow_pool_prev x tail_decay + current lines. Taps the mask-applied internal (same source as the bloom; the tail is phosphor emission, downstream of the mask). u_tail_freeze is injected by the renderer (1 while emulation time is not advancing, e.g. pause) to hold the pool",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "tail_strength", "value": 0.0 }
			],
			"input": [
				{ "sampler": "s_prev", "target": "slow_pool" },
				{ "sampler": "s_tex",  "target": "internal" }
			],
			"uniforms": [
				{ "uniform": "u_tail_decay", "slider": "tail_decay" }
			],
			"output": "slow_pool"
		},

		{ "effect": "vector/vector_glow_blit", "name": "Analytic Glow Composite",
		  "_comment": "Add the separate analytic-glow FBO (glow0) into internal AFTER the shadow mask / tint, so the broad scattered glow is not patterned by the mask. disablewhen keeps it free when analytic_glow is 0",
		  "disablewhen": [
		    { "type": "slider", "condition": "equal", "combine": "and", "name": "analytic_glow", "value": 0.0 },
		    { "type": "slider", "condition": "equal", "combine": "and", "name": "ring_gain",     "value": 0.0 },
		    { "type": "slider", "condition": "equal", "combine": "and", "name": "ring_fill",     "value": 0.0 },
		    { "type": "slider", "condition": "equal", "combine": "and", "name": "intensity_overdrive", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "texture": "glow" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] }, { "uniform": "u_glow_defocus", "slider": "defocus" } ],
		  "output": "internal" },
		{ "_comment": "8-level 0.5x bloom. Bloom source = mask-applied internal. bloom_lvl0..7 (window/2..window/256) are created on the C++ side. vector_downsample (4-tap) shrinks by 0.5x repeatedly; the ladder below accumulates the levels into acc0..acc6",
		  "effect": "vector/vector_downsample", "name": "ds_bloom0", "input": [ { "sampler": "s_tex", "target": "internal"   } ], "output": "bloom_lvl0" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom1", "input": [ { "sampler": "s_tex", "target": "bloom_lvl0" } ], "output": "bloom_lvl1" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom2", "input": [ { "sampler": "s_tex", "target": "bloom_lvl1" } ], "output": "bloom_lvl2" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom3", "input": [ { "sampler": "s_tex", "target": "bloom_lvl2" } ], "output": "bloom_lvl3" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom4", "input": [ { "sampler": "s_tex", "target": "bloom_lvl3" } ], "output": "bloom_lvl4" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom5", "input": [ { "sampler": "s_tex", "target": "bloom_lvl4" } ], "output": "bloom_lvl5" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom6", "input": [ { "sampler": "s_tex", "target": "bloom_lvl5" } ], "output": "bloom_lvl6" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom7", "input": [ { "sampler": "s_tex", "target": "bloom_lvl6" } ], "output": "bloom_lvl7" },

		{ "_comment": "Stage 2 ladder: replaces add_bloom_lvl0..7 + halo blur. Same weighted sum (acc0 = sum of w_n x lvl_n) but deeper levels pass through repeated bilinear upsampling, which smooths them like the old halo",
		  "effect": "vector/vector_blit_add", "name": "seed_acc6",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl6" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl6_weight" } ], "output": "acc6" },
		{ "effect": "vector/vector_blit_add", "name": "add_lvl7_to_acc6", "clear": {}, "input": [ { "sampler": "s_tex", "target": "bloom_lvl7" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl7_weight" } ], "output": "acc6" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc5",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl5_weight" } ], "output": "acc5" },
		{ "effect": "vector/vector_upsample", "name": "up_acc6_to_acc5", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc6" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc5" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc4",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl4_weight" } ], "output": "acc4" },
		{ "effect": "vector/vector_upsample", "name": "up_acc5_to_acc4", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc4" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc3",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl3_weight" } ], "output": "acc3" },
		{ "effect": "vector/vector_upsample", "name": "up_acc4_to_acc3", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc3" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc2",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl2_weight" } ], "output": "acc2" },
		{ "effect": "vector/vector_upsample", "name": "up_acc3_to_acc2", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc2" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc1",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl1_weight" } ], "output": "acc1" },
		{ "effect": "vector/vector_upsample", "name": "up_acc2_to_acc1", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc1" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc0",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl0" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl0_weight" } ], "output": "acc0" },
		{ "effect": "vector/vector_upsample", "name": "up_acc1_to_acc0", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc0" },

		{ "effect": "vector/vector_blit_add", "name": "tail_add", "clear": {},
		  "_comment": "composite the slow tail: ADD slow_pool x tail_strength onto acc0 (same half resolution, single-buffered like the ladder), so it reaches the image through Bloom Apply. internal cannot take a partial ADD directly (doublebuffered)",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "tail_strength", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "slow_pool" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "tail_strength" } ],
		  "output": "acc0" },

				{ "effect": "vector/vector_bloom_apply", "name": "Bloom Apply",
		  "_comment": "compose bloom after the shadow mask. Following the physical order (beam -> mask filtering -> emission -> light scatter(bloom) -> glass), the mask acts only on the incident side; the outgoing scattered light (bloom) is unaffected by the mask",
		  "input": [ { "sampler": "s_base", "target": "internal" }, { "sampler": "s_bloom", "target": "acc0" } ],
		  "uniforms": [
			{ "uniform": "u_bloom_base_weight", "slider":    "bloom_base_weight" },
			{ "uniform": "u_bloom_scale",       "slider":    "bloom_scale" },
			{ "uniform": "u_bloom_overdrive",   "slider":    "bloom_overdrive" },
			{ "uniform": "u_bloom_channel_gain","slider":    "bloom_channel_gain" },
			{ "uniform": "u_ambient_color",     "slider":    "ambient_color" },
			{ "uniform": "u_ambient_level",     "slider":    "ambient_level" },
			{ "uniform": "u_time",              "parameter": "time" }
		  ],
		  "output": "internal" },

		
		{   "effect": "hlsl/distortion",
			"name": "Distortion Pass",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",      "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "distortion",       "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "cubic_distortion", "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "distort_corner",   "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "round_corner",     "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "smooth_border",    "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vignetting",       "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "reflection",       "value": 0.0 }
			],
			"uniforms": [
				{ "uniform": "u_distortion",       "slider": "distortion" },
				{ "uniform": "u_cubic_distortion", "slider": "cubic_distortion" },
				{ "uniform": "u_distort_corner",   "slider": "distort_corner" },
				{ "uniform": "u_round_corner",     "slider": "round_corner" },
				{ "uniform": "u_smooth_border",    "slider": "smooth_border" },
				{ "uniform": "u_vignetting",       "slider": "vignetting" },
				{ "uniform": "u_reflection",       "slider": "reflection" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{ "effect": "misc/blit", "name": "mglow_seed",
		  "_comment": "seed mglow_out with the final image; add_mglow then additively blends the radial glow on top (vector_monitor_glow outputs glow only with additive blend, so the target must already hold the image)",
		  "input": [ { "sampler": "s_tex", "target": "internal" } ],
		  "output": "mglow_out" },
		{ "effect": "vector/vector_monitor_glow", "name": "add_mglow", "clear": {},
		  "_comment": "monitor glow: screen-edge glow from off-screen beam energy (u_mglow_amount injected by the renderer), additively composited over the seeded image; clear:{} preserves the seed",
		  "input": [ { "sampler": "s_tex", "target": "mglow_out" } ],
		  "uniforms": [ { "uniform": "u_mglow_brightness", "slider": "mglow_brightness" }, { "uniform": "u_mglow_edge_diff", "slider": "mglow_center_edge_diff" } ],
		  "output": "mglow_out" },
		{ "effect": "vector/vector_temporal_lp", "name": "Temporal Smooth",
		  "_comment": "temporal low-pass (EMA) of the final image: out = mix(cur, prev, k). Independent flicker knob from Flicker Persist - symmetric averaging (damps all variation, blurs motion) vs the max pass (keeps peaks, trails only). flicker_smooth 0 = off (bypassed)",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "flicker_smooth", "value": 0.0 } ],
		  "input": [ { "sampler": "s_prev", "target": "smooth_pool" }, { "sampler": "s_tex", "target": "mglow_out" } ],
		  "uniforms": [ { "uniform": "u_smooth_k", "slider": "flicker_smooth" } ],
		  "output": "smooth_pool" },
		{ "effect": "misc/blit", "name": "Temporal Smooth Writeback",
		  "_comment": "copy the smoothed result back into mglow_out for the Final Blit (smooth_pool is the doublebuffered EMA history)",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "flicker_smooth", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "smooth_pool" } ],
		  "output": "mglow_out" },
		{   "effect": "misc/blit",
			"name": "Final Blit (-> screen_hdr, linear)",
			"_comment": "linear chain output goes to the sampleable screen_hdr target; the renderer's HDR composite pass adds the backdrop, alpha-composites bezel/UI and PQ-encodes the backbuffer (vector-hdr-display-study.md 4.1)",
			"input": [
				{ "sampler": "s_tex", "target": "mglow_out" }
			],
			"output": "screen_hdr"
		}
	]
}
