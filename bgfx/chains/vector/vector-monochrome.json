		{"type":"float","name":"ray_angle","text":"Starburst Angle (deg)","default":15.0,"min":0.0,"max":180.0,"step":1.0,"format":"%3.0f","screen":"vector","advanced":true},

		// ---- Convergence ----
		{"type":"float","name":"convergence_global_gain","text":"Convergence Global Bloom","default":0.0,"min":0.0,"max":0.5,"step":0.005,"format":"%1.3f","screen":"vector","advanced":true},
		{"type":"float","name":"convergence_global_coverage","text":"Convergence Global Coverage","default":0.55,"min":0.1,"max":1.2,"step":0.025,"format":"%1.3f","screen":"vector","advanced":true},

		// ---- Beam time window ----
		{"type":"intenum","name":"beam_window","text":"Beam Time Window","default":1,"min":0,"max":1,"step":1,"format":"%s","screen":"vector","advanced":true,"strings":["Off (Cyclic Flicker)","On"]},
		{"type":"float","name":"beam_window_scale","text":"Beam Time Window Rate (x real time)","default":1.5,"min":0.25,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"beam_flash_ms","text":"Beam Strike Flash (ms)","default":1.0,"min":0.0,"max":40.0,"step":0.5,"format":"%2.1f","screen":"vector","advanced":true},
		{"type":"float","name":"beam_flash_gain","text":"Beam Strike Flash Gain (x)","default":1.5,"min":1.0,"max":8.0,"step":0.1,"format":"%1.1f","screen":"vector","advanced":true},

		// ---- Flicker, HV droop and beam jitter ----
		{"type":"float","name":"flicker_thresh_ms","text":"Cyclic Flicker Threshold (draw ms)","default":22.0,"min":0.0,"max":300.0,"step":1.0,"format":"%3.0f","screen":"vector","advanced":true},
		{"type":"float","name":"flicker_buckets","text":"Cyclic Flicker Buckets (N)","default":6.0,"min":2.0,"max":16.0,"step":1.0,"format":"%2.0f","screen":"vector","advanced":true},
		{"type":"float","name":"flicker_period_ms","text":"Cyclic Flicker Step (ms)","default":16.7,"min":2.0,"max":100.0,"step":0.5,"format":"%2.1f","screen":"vector","advanced":true},

		// ---- Vector geometry ----
		{"type":"float","name":"vector_linearity_x","text":"Vector Linearity X (gain)","default":1.0,"min":0.8,"max":1.2,"step":0.005,"format":"%1.3f","screen":"vector","advanced":true},
		{"type":"float","name":"vector_linearity_y","text":"Vector Linearity Y (gain)","default":1.0,"min":0.8,"max":1.2,"step":0.005,"format":"%1.3f","screen":"vector","advanced":true},
		{"type":"float","name":"vector_pincushion_x_quad","text":"Vector Pincushion X (Quad)","default":0.0,"max":1.0,"min":-1.0,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"vector_image_scale","text":"Vector Image Scale","default":0.95,"min":0.75,"max":1.15,"step":0.005,"format":"%1.3f","screen":"vector","advanced":true},

		// ---- Tube, ambient and bezel ----
		{"type":"float","name":"tube_distortion","text":"Tube Quadric Distortion","default":0.15,"min":-2.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"tube_round_corner","text":"Tube Rounded Corner","default":0.2,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"tube_vignetting","text":"Tube Vignetting","default":0.8,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"tube_face_scale","text":"Tube Face Scale","default":0.99,"min":0.8,"max":1.0,"step":0.005,"format":"%1.3f","screen":"vector","advanced":true},
		{"type":"color","name":"ambient_color","text":"Ambient Color ","default":[0.35,0.45,0.38],"max":[1.0,1.0,1.0],"min":[0.0,0.0,0.0],"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"ambient_level","text":"Ambient Level (x0.001)","default":1.0,"min":0.0,"max":200.0,"step":0.5,"format":"%3.1f","screen":"vector","advanced":true},
		{"type":"float","name":"bezel_glow_strength","text":"Bezel Reflection Glow","default":0.25,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"bezel_glow_width","text":"Bezel Glow Width (px)","default":32.0,"min":2.0,"max":200.0,"step":1.0,"format":"%3.0f","screen":"vector","advanced":true},
		{"type":"float","name":"bezel_glow_curve","text":"Bezel Glow Curve","default":2.0,"min":0.25,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},

		// ---- HDR / SDR presentation ----
		{"type":"float","name":"beam_peak_nits","text":"HDR Beam Peak (nits)","default":192,"min":80.0,"max":2000.0,"step":2.0,"format":"%4.0f","screen":"vector","advanced":true},
		{"type":"float","name":"hdr_glow_stability","text":"HDR Glow Stability","default":1.0,"min":0.0,"max":1.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"hdr_rolloff_knee","text":"HDR Highlight Knee (xpeak)","default":1.0,"min":0.5,"max":2.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"hdr_rolloff_max","text":"HDR Highlight Max (xpeak)","default":2.5,"min":0.5,"max":8.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"hdr_sat_protect","text":"HDR Saturated Color Protect","default":1.0,"min":0.0,"max":1.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"sdr_beam_level","text":"SDR Beam Level","default":0.72,"min":0.10,"max":1.00,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"bright_normal_cap","text":"SDR Normal Brightness Cap","default":0.6,"min":0.1,"max":1.0,"step":0.01,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"sdr_rolloff_knee","text":"SDR Highlight Knee (xwhite)","default":0.75,"min":0.1,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"sdr_rolloff_ceiling","text":"SDR Highlight Ceiling (xwhite)","default":1.00,"min":0.1,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true},
		{"type":"float","name":"sdr_shadow_curve","text":"SDR Shadow Curve","default":0.95,"min":0.3,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector","advanced":true}
	],

	"parameters": [
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{ "name": "internal",  "mode": "native", "scale": 1, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "glow_accum", "mode": "native", "scale": 0.5, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "Half-resolution accumulator matching the renderer glow FBO; beam, no-persist content and phosphor pool remain full resolution." },
		{ "name": "phos_pool", "mode": "native", "scale": 1, "doublebuffer": true, "format": "RG11B10F", "attachments": 2,
		  "_comment": "phosphor pool: rgb = peak excitation colour, a = age (ms). Held + decayed by S(age). RGBA16F so age fits in alpha and colour is preserved (mono now, imager/AVG colour later)." },
		{ "name": "screen_hdr","mode": "native", "scale": 1, "doublebuffer": false, "format": "RG11B10F",
		  "_comment": "linear chain output; its presence makes the renderer present this as an HDR chain (PQ/EDR, SDR fallback)" },
		{ "name": "glow_lo0", "mode": "native", "scale": 0.5, "scale_reference": 1920,     "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "wide local glow: the per-line glow buffer cascaded down to low-res, then upscaled+added. Bounded spread (down to 1/16) = wide but still LOCAL (does not reach the whole screen like the bloom ladder)." },
		{ "name": "glow_lo1", "mode": "native", "scale": 0.25, "scale_reference": 1920,    "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo2", "mode": "native", "scale": 0.125, "scale_reference": 1920,   "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo3", "mode": "native", "scale": 0.0625, "scale_reference": 1920,  "doublebuffer": false, "format": "RGBA16F" }
	],

	"passes": [
		{ "effect": "vector/vector_linearize", "name": "Initial Blit (linearize, screen -> internal)",
		  "_comment": "A4: guest and the identity same-scale Prescale copy are removed; linearize writes directly to the full-resolution RG11B10F internal ping-pong target.",
		  "input": [ { "sampler": "s_tex", "texture": "screen" } ], "output": "internal" },

		{ "effect": "vector/vector_phosphor", "name": "Phosphor",
		  "_comment": "pool update: rgb=peak,a=age. If the fresh frame is brighter than the decayed pool the pixel re-excites (age 0), else the peak holds and age advances by dt. u_phos = (dt_ms, half, curve, total) injected by the renderer. Reads+writes phos_pool in place (doublebuffered feedback).",
		  "input": [ { "sampler": "s_prev", "target": "phos_pool" }, { "sampler": "s_tex", "target": "internal" }, { "sampler": "s_prev_age", "target": "phos_pool", "attachment": 1 } ],
		  "uniforms": [ { "uniform": "u_overlap_white_strength", "value": [ 0.0 ] },
			{ "uniform": "u_phos_peak", "slider": "masked_core_peak" } ], "output": "phos_pool" },

		{ "effect": "vector/vector_phosphor_compose", "name": "Phosphor Apply",
		  "_comment": "single compose pass replacing the former Phosphor Apply (pool emit) + NoPersist Combine + Phosphor Tint trio - two full-res passes saved, math unchanged: internal = (pool_peak * S(age) + npglow * cap_no_persist) * phosphor_color. The no-persist FBO holds short-dwell junction dots (bright while drawn, no afterimage, never fed into the glow cascade); the old pass pair's net 0.3745 x 2.67 = 0.99991 add is exactly 1.0 here (that was the intent), and u_np_gain=0 both reproduces the old disablewhen skip and guards stale np content. The entry keeps the name 'Phosphor Apply' because the renderer injects u_phos into it by name.",
		  "input": [ { "sampler": "s_tex", "target": "phos_pool" }, { "sampler": "s_np", "texture": "npglow" }, { "sampler": "s_cur", "target": "internal" }, { "sampler": "s_age", "target": "phos_pool", "attachment": 1 } ],
		  "uniforms": [
			{ "uniform": "u_np_gain",           "slider": "cap_no_persist" }, { "uniform": "u_fresh_gain", "slider": "fresh_hit_gain" },
			{ "uniform": "u_phos_peak",         "slider": "masked_core_peak" },
			{ "uniform": "u_line_channel_gain", "slider": "phosphor_color" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_glow_accum", "name": "Glow Accum Narrow",
		  "_comment": "Stage 1 (narrow): one-tap seed of glow_accum. The former 9-tap effect had a hard-wired zero defocus offset, so all nine reads sampled the same texel; this dedicated pass is visually equivalent for ordinary glow; explicit halation/starburst content now bypasses this accumulator and tail shaping.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "texture": "glow" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_narrow" } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds0", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "texture": "glow" } ],   "output": "glow_lo0" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds1", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ], "output": "glow_lo1" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds2", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "output": "glow_lo2" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds3", "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "output": "glow_lo3" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo2" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo1" },

		{ "effect": "vector/vector_upsample", "name": "wide_glow_us0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo0" },

		{ "effect": "vector/vector_blit_add", "name": "Glow Accum Wide",
		  "_comment": "Stage 2 (wide): ADD the broad far-only halo (1/16 smooth upscale from glow_lo0) into glow_accum. clear:{} PRESERVES the narrow seed above (single-buffer, so this partial ADD is safe). Result = narrow + wide in glow_accum.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_wide" } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_glow_combine_mono_defocus", "name": "Glow Combine",
		  "_comment": "Fused post-phosphor 9-tap defocus + asymmetric vector pincushion + flat phosphor-body ambient + calibrated glow. No shadow-mask texture is sampled; u_glow_enable guards stale glow_accum, while s_optical adds halation/starburst without Glow Tail Curve or Black Toe shaping.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "combine": "and", "name": "analytic_glow",             "value": 0.0 }, { "type": "slider", "condition": "equal", "combine": "and", "name": "ring_gain",                 "value": 0.0 }, { "type": "slider", "condition": "equal", "combine": "and", "name": "ring_fill",                 "value": 0.0 }, { "type": "slider", "condition": "equal", "combine": "and", "name": "ray_gain",                  "value": 0.0 }, { "type": "slider", "condition": "equal", "combine": "and", "name": "ambient_level",            "value": 0.0 }, { "type": "slider", "condition": "equal", "combine": "and", "name": "defocus",                 "value": [ 0, 0 ] }, { "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_quad",  "value": 0.0 } ],
		  "input": [ { "sampler": "s_base", "target": "internal" }, { "sampler": "s_bloom", "target": "glow_accum" }, { "sampler": "s_optical", "texture": "optical" }, { "sampler": "s_bezel_source", "texture": "glow" }, { "sampler": "s_bezel_length", "texture": "bezel_length" } ],
		  "uniforms": [ { "uniform": "u_defocus",                    "slider": "defocus" }, { "uniform": "u_vec_pincushion_x_quad",      "slider": "vector_pincushion_x_quad" }, { "uniform": "u_glow_enable",                "slider": "analytic_glow" }, { "uniform": "u_masked_core_peak_emit", "slider": "masked_core_peak_emit" }, { "uniform": "u_ambient_color",               "slider": "ambient_color" }, { "uniform": "u_ambient_level",               "slider": "ambient_level" }, { "uniform": "u_tube_distortion",       "slider": "tube_distortion" }, { "uniform": "u_tube_round_corner",     "slider": "tube_round_corner" }, { "uniform": "u_tube_vignetting",       "slider": "tube_vignetting" }, { "uniform": "u_tube_face_scale",       "slider": "tube_face_scale" }, { "uniform": "u_vector_image_scale",    "slider": "vector_image_scale" }, { "uniform": "u_bezel_glow_strength",   "slider": "bezel_glow_strength" }, { "uniform": "u_bezel_glow_width",      "slider": "bezel_glow_width" }, { "uniform": "u_bezel_glow_curve",      "slider": "bezel_glow_curve" }, { "uniform": "u_glow_tail_curve",       "slider": "glow_tail_curve" }, { "uniform": "u_glow_black_toe",        "slider": "glow_black_toe" } ],
		  "output": "internal" },

		{ "effect": "misc/blit", "name": "Final Blit (unwarped -> screen_hdr)",
		  "_comment": "The vector image is never warped by monitor curvature; tube curvature is applied only to ambient illumination inside Glow Combine.",
		  "input": [ { "sampler": "s_tex", "target": "internal" } ], "output": "screen_hdr" }
	]
}
