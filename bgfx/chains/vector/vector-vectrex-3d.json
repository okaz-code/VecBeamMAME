// Vectrex 3-D (anaglyph / side-by-side) chain. A minimal pass-through like default-vector: it just
// blits drawbgfx's analytic vector FBO to the output with NO colour-mixing post (no Color Convolution
// grayscale/tint, no bloom, no phosphor accumulation, no shadow mask). Those passes blend the left/right
// eye colours together and destroy the red/cyan (or side-by-side) stereo separation, so they are omitted.
// Only the per-vertex beam-width and beam-intensity transfers (done inside the analytic line shader, not
// a chain pass, so they do not mix colours) are exposed for tuning. Beam widths default to the Vectrex
// values; intensity/width clips are neutral.
{
	"name": "Vector (Vectrex 3D)",
	"author": "okaz-code",
	"screen_type": "vector",

	"sliders": [
		{ "type": "float", "name": "beam_width_min",      "text": "Beam Width Minimum",        "default": 5.0,  "min": 0.1,  "max": 8.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_width_max",      "text": "Beam Width Maximum",        "default": 12.0, "min": 0.1,  "max": 20.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "width_clip_low",      "text": "Width Clip Low",            "default": 0.0,  "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "width_clip_high",     "text": "Width Clip High",           "default": 1.0,  "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "width_curve",         "text": "Width Curve (1=linear)",    "default": 1.0,  "min": 0.25, "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "point_width_scale",   "text": "Point Width Scale",         "default": 1.0,  "min": 0.0,  "max": 8.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "line_point_threshold","text": "Line Point Threshold",      "default": 2.0,  "min": 0.0,  "max": 10.0, "step": 0.5,  "format": "%2.1f", "screen": "vector" },
		{ "type": "float", "name": "line_cap_brightness", "text": "Line Cap Brightness",       "default": 1.0,  "min": 0.0,  "max": 3.0,  "step": 0.05, "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "line_cap_width",      "text": "Line Cap Width (x beam)",   "default": 1.5,  "min": 0.5,  "max": 4.0,  "step": 0.1,  "format": "%1.1f", "screen": "vector" },
		{ "type": "float", "name": "intensity_clip_low",  "text": "Intensity Clip Low",         "default": 0.0,  "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "intensity_clip_high", "text": "Intensity Clip High",        "default": 1.0,  "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "intensity_curve",     "text": "Intensity Curve (1=linear)", "default": 1.0,  "min": 0.25, "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" }
	],

	"targets": [
		{   "name": "guest",
			"mode": "guest",
			"bilinear": true,
			"user_prescale": true
		}
	],

	"passes": [
		{   "effect": "misc/blit",
			"name": "Copy vector FBO to guest texture",
			"input": [
				{ "sampler": "s_tex", "texture": "screen" }
			],
			"output": "guest"
		},
		{   "effect": "misc/blit",
			"name": "Final blit to output",
			"input": [
				{ "sampler": "s_tex", "target": "guest" }
			],
			"output": "output"
		}
	]
}
