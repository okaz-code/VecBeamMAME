// CRT chain for color vectors with beam overload. Same CRT pipeline as the color chain plus the
// overload_* / beam_* / dot sliders consumed by drawbgfx's renderer-side overload model (beam
// widening + defocus driven by the device's normalized beam-energy value).
//   Bloom uses 8 levels at 0.5x (bloom_lvl0..7 = window/2..window/256 generated by vector_downsample,
//   ladder-accumulated into the window-proportional acc0..acc6 pyramid (RGBA16F) with 9-tap tent upsample.
{
	"name": "Vector (Overload)",
	"author": "Ryan Holtz & ImJezze (original HLSL) / okaz (vector adaptation)",
	"screen_type": "vector",

	"sliders": [
		{ "type": "float", "name": "beam_width_min",            "text": "Beam Width Minimum",        "default": 1.0,  "min": 0.1,  "max": 5.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_width_max",            "text": "Beam Width Maximum",        "default": 1.5,  "min": 0.1,  "max": 20.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
