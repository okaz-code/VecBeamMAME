		{"type":"vec2","name":"converge_blue","text":"Blue Linear Convergence, ","default":[0.0,0.0],"max":[10.0,10.0],"min":[-10.0,-10.0],"step":0.1,"format":"%2.1f","screen":"vector"},
		{"type":"vec2","name":"radial_converge_red","text":"Red Radial Convergence, ","default":[0.0,0.0],"max":[0.1,0.1],"min":[-0.1,-0.1],"step":0.001,"format":"%1.3f","screen":"vector"},
		{"type":"vec2","name":"radial_converge_green","text":"Green Radial Convergence, ","default":[0.0,0.0],"max":[0.1,0.1],"min":[-0.1,-0.1],"step":0.001,"format":"%1.3f","screen":"vector"},
		{"type":"vec2","name":"radial_converge_blue","text":"Blue Radial Convergence, ","default":[0.0,0.0],"max":[0.1,0.1],"min":[-0.1,-0.1],"step":0.001,"format":"%1.3f","screen":"vector"},
		{"type":"float","name":"vector_linearity_x","text":"Vector Linearity X (gain)","default":1.0,"min":0.8,"max":1.2,"step":0.005,"format":"%1.3f","screen":"vector"},
		{"type":"float","name":"vector_linearity_y","text":"Vector Linearity Y (gain)","default":1.0,"min":0.8,"max":1.2,"step":0.005,"format":"%1.3f","screen":"vector"},
		{"type":"float","name":"vector_pincushion_x_quad","text":"Vector Pincushion X (Quad)","default":0.0,"max":1.0,"min":-1.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"vector_pincushion_x_cubic","text":"Vector Pincushion X (Cubic)","default":0.0,"max":1.0,"min":-1.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"vector_pincushion_y_quad","text":"Vector Pincushion Y (Quad)","default":0.0,"max":1.0,"min":-1.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"vector_pincushion_y_cubic","text":"Vector Pincushion Y (Cubic)","default":0.0,"max":1.0,"min":-1.0,"step":0.01,"format":"%1.2f","screen":"vector"},

		// ---- Shadow mask ----
		{"type":"float","name":"shadow_mask_strength","text":"Shadow Mask Strength","default":0.3,"min":0.0,"max":1.0,"step":0.01,"format":"%2.2f","screen":"vector"},
		{"type":"float","name":"shadow_mask_brightboost","text":"Shadow Mask Brightness Boost","default":0.0,"min":0.0,"max":2.0,"step":0.05,"format":"%2.2f","screen":"vector"},
		{"type":"float","name":"shadow_mask_scale","text":"Shadow Mask Size (px @1080p)","default":0.65,"min":0.25,"max":8.0,"step":0.05,"format":"%1.2f","screen":"vector"},

		// ---- Ambient, tube and bezel ----
		{"type":"color","name":"ambient_color","text":"Ambient Color ","default":[0.35,0.35,0.35],"max":[1.0,1.0,1.0],"min":[0.0,0.0,0.0],"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"ambient_level","text":"Ambient Level (x0.001)","default":30.0,"min":0.0,"max":200.0,"step":0.5,"format":"%2.1f","screen":"vector"},
		{"type":"float","name":"tube_distortion","text":"Tube Quadric Distortion","default":0.12,"min":-2.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"tube_cubic_distortion","text":"Tube Cubic Distortion","default":0.0,"min":-2.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"tube_distort_corner","text":"Tube Corner Distortion","default":0.0,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"tube_round_corner","text":"Tube Rounded Corner","default":0.0,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"tube_smooth_border","text":"Tube Smooth Border","default":0.0,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"tube_vignetting","text":"Tube Vignetting","default":0.8,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"tube_face_scale","text":"Phosphor Face Scale","default":0.96,"min":0.8,"max":1.0,"step":0.005,"format":"%1.3f","screen":"vector"},
		{"type":"float","name":"vector_image_scale","text":"Vector Image Scale","default":0.96,"min":0.75,"max":1.0,"step":0.005,"format":"%1.3f","screen":"vector"},
		{"type":"float","name":"bezel_glow_strength","text":"Bezel Reflection Glow","default":0.4,"min":0.0,"max":2.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"bezel_glow_width","text":"Bezel Glow Width (px)","default":32.0,"min":2.0,"max":200.0,"step":1.0,"format":"%3.0f","screen":"vector"},
		{"type":"float","name":"bezel_glow_curve","text":"Bezel Glow Curve","default":2.0,"min":0.25,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"bezel_glow_inside","text":"Bezel Glow Inside Balance","default":0.25,"min":0.0,"max":1.0,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"glow_tail_curve","text":"Glow Tail Curve","default":1.22,"min":0.4,"max":2.5,"step":0.02,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"glow_black_toe","text":"Glow Black Toe","default":0.002,"min":0.0,"max":0.05,"step":0.001,"format":"%1.3f","screen":"vector"},
		{"type":"float","name":"ambient_mask","text":"Ambient Shadow-Mask (0=flat,1=masked)","default":1.0,"min":0.0,"max":1.0,"step":0.05,"format":"%1.2f","screen":"vector"},

		// ---- HDR / SDR presentation ----
		{"type":"float","name":"beam_peak_nits","text":"HDR Beam Peak (nits)","default":330.0,"min":80.0,"max":2000.0,"step":10.0,"format":"%4.0f","screen":"vector"},
		{"type":"float","name":"hdr_rolloff_knee","text":"HDR Highlight Knee (xpeak)","default":1.0,"min":0.5,"max":2.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"hdr_rolloff_max","text":"HDR Highlight Max (xpeak)","default":1.85,"min":0.5,"max":8.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"hdr_sat_protect","text":"HDR Saturated Color Protect","default":0.5,"min":0.0,"max":1.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"sdr_beam_level","text":"SDR Beam Level","default":0.70,"min":0.10,"max":1.00,"step":0.01,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"sdr_rolloff_knee","text":"SDR Highlight Knee (xwhite)","default":0.75,"min":0.1,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"sdr_rolloff_ceiling","text":"SDR Highlight Ceiling (xwhite)","default":1.0,"min":0.1,"max":4.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"sdr_shadow_curve","text":"SDR Shadow Curve","default":1.10,"min":0.3,"max":3.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"edr_sdr_level","text":"EDR SDR Level (UI/Art, macOS)","default":1.0,"min":0.1,"max":1.0,"step":0.05,"format":"%1.2f","screen":"vector"},
		{"type":"float","name":"phosphor_gamut","text":"Phosphor Gamut (P22, HDR)","default":0.0,"min":0.0,"max":1.0,"step":0.05,"format":"%1.2f","screen":"vector"}
	],

	"parameters": [
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{ "name": "internal",  "mode": "native", "scale": 0.5, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "glow_accum", "mode": "native", "scale": 0.25, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "BALANCED: half-resolution accumulator matching the renderer glow FBO. The full-resolution beam and phosphor pool remain untouched; Glow Combine upsamples this smooth light field." },
		{ "name": "phos_pool", "mode": "native", "scale": 0.5, "doublebuffer": true, "format": "RGBA16F",
		  "_comment": "phosphor pool: rgb = peak excitation colour, a = age (ms). Held + decayed by S(age). RGBA16F so age fits in alpha and colour is preserved (mono now, imager/AVG colour later)." },

		{ "name": "screen_hdr","mode": "native", "scale": 1, "doublebuffer": false, "format": "RG11B10F",
		  "_comment": "linear chain output; its presence makes the renderer present this as an HDR chain (PQ/EDR, SDR fallback)" },
		{ "name": "glow_lo0", "mode": "native", "scale": 0.25,     "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "wide local glow: the per-line glow buffer cascaded down to low-res, then upscaled+added. Bounded spread (only down to 1/16) = wide but still LOCAL (does not reach the whole screen like the bloom ladder)." },
		{ "name": "glow_lo1", "mode": "native", "scale": 0.125,    "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo2", "mode": "native", "scale": 0.0625,   "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo3", "mode": "native", "scale": 0.03125,  "doublebuffer": false, "format": "RGBA16F" }
	],

	"passes": [
		{ "effect": "vector/vector_linearize", "name": "Initial Blit (linearize, screen -> internal)",
		  "_comment": "A4: guest and the identity same-scale Prescale copy are removed; linearize writes directly to the half-resolution RG11B10F internal ping-pong target.",
		  "input": [ { "sampler": "s_tex", "texture": "screen" } ], "output": "internal" },

		{ "effect": "hlsl/color", "name": "Color Convolution",
		  "_comment": "color_saturation slider: 0 = force grayscale (mono CRT), 1 = pass the source beam colour through to the phosphor pool (3D imager / colour sources). Provably an identity transform at saturation==1 (verified against fs_color.sc: Saturated = OutLuma + OutChroma*1 = OutTexel exactly), so that default is skipped outright.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "color_saturation", "value": 1.0 } ],
		  "uniforms": [
			{ "uniform": "u_red_ratios", "value": [ 1.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_grn_ratios", "value": [ 0.0, 1.0, 0.0, 0.0 ] },
			{ "uniform": "u_blu_ratios", "value": [ 0.0, 0.0, 1.0, 0.0 ] },
			{ "uniform": "u_offset",     "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_scale",      "value": [ 1.0, 1.0, 1.0, 0.0 ] },
			{ "uniform": "u_saturation", "slider": "color_saturation" } ],
		  "input": [ { "sampler": "s_tex", "target": "internal" } ], "output": "internal" },


		{   "effect": "hlsl/deconverge",
			"name": "Deconvergence",
			"_comment": "electron-gun misalignment (linear + radial per-channel offset). Placed after source linearization/optional colour convolution and BEFORE the phosphor pool/chroma mode: convergence is a property of THIS frame's raw RGB signal (misaimed guns), decided before the pool judges what's lit and before any colour-science/geometry passes touch it.",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_red",          "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_green",        "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_blue",         "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_red",   "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_green", "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_blue",  "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_converge_red",          "slider": "converge_red"   },
				{ "uniform": "u_converge_green",        "slider": "converge_green" },
				{ "uniform": "u_converge_blue",         "slider": "converge_blue"  },
				{ "uniform": "u_radial_converge_red",   "slider": "radial_converge_red"   },
				{ "uniform": "u_radial_converge_green", "slider": "radial_converge_green" },
				{ "uniform": "u_radial_converge_blue",  "slider": "radial_converge_blue"  }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},

		{   "effect": "hlsl/post",
			"name": "Chroma Mode Pass",
			"_comment": "signal-domain colour mode (Monochrome/Dichrome/Trichrome) via HLSL post's chroma path; shadow/floor/power/humbar fixed neutral. Runs BEFORE the phosphor pool (the pool decays in phosphor space).",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "chroma_mode", "value": 3 }
			],
			"uniforms": [
				{ "uniform": "u_shadow_tile_mode",       "value":  [ 0.0 ] },
				{ "uniform": "u_shadow_alpha",           "value":  [ 0.0 ] },
				{ "uniform": "u_shadow_count",           "value":  [ 1.0, 1.0 ] },
				{ "uniform": "u_shadow_uv",              "value":  [ 0.0, 0.0 ] },
				{ "uniform": "u_shadow_uv_offset",       "value":  [ 0.0, 0.0 ] },
				{ "uniform": "u_humbar_alpha",           "value":  [ 0.0 ] },
				{ "uniform": "u_humbar_hertz_rate",      "value":  [ 0.0 ] },
				{ "uniform": "u_floor",                  "value":  [ 0.0, 0.0, 0.0 ] },
				{ "uniform": "u_power",                  "value":  [ 1.0, 1.0, 1.0 ] },
				{ "uniform": "u_chroma_mode",            "slider": "chroma_mode" },
				{ "uniform": "u_conversion_gain",        "slider": "chroma_conversion_gain" },
				{ "uniform": "u_time",                   "parameter": "time" }
			],
			"input": [
				{ "sampler": "s_tex",    "target": "internal" },
				{ "sampler": "s_shadow", "texture": "bgfx/chains/crt-geom/aperture_1_2_bgr.png" }
			],
			"output": "internal"
		},

		{ "effect": "vector/vector_phosphor", "name": "Phosphor",
		  "_comment": "pool update: rgb=peak,a=age. If the fresh frame is brighter than the decayed pool the pixel re-excites (age 0), else the peak holds and age advances by dt. u_phos = (dt_ms, half, curve, total) injected by the renderer. Reads+writes phos_pool in place (doublebuffered feedback).",
		  "input": [ { "sampler": "s_prev", "target": "phos_pool" }, { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [], "output": "phos_pool" },
		{ "effect": "vector/vector_phosphor_compose_color", "name": "Phosphor Apply",
		  "_comment": "colour compose: pool emit + converged no-persist caps/dots + phosphor tint + CIE phosphor-to-sRGB conversion in one pass. This preserves the old ordering while removing the full-res npglow_dc target/pass and the following chroma pass. The entry name remains 'Phosphor Apply' for renderer u_phos injection.",
		  "input": [ { "sampler": "s_tex", "target": "phos_pool" }, { "sampler": "s_np", "texture": "npglow" }, { "sampler": "s_cur", "target": "internal" } ],
		  "uniforms": [
			{ "uniform": "u_np_gain",           "slider": "cap_no_persist" },
			{ "uniform": "u_phos_debug",        "slider": "phos_debug" },
			{ "uniform": "u_line_channel_gain", "slider": "phosphor_color" },
			{ "uniform": "u_converge_red",          "slider": "converge_red" },
			{ "uniform": "u_converge_green",        "slider": "converge_green" },
			{ "uniform": "u_converge_blue",         "slider": "converge_blue" },
			{ "uniform": "u_radial_converge_red",   "slider": "radial_converge_red" },
			{ "uniform": "u_radial_converge_green", "slider": "radial_converge_green" },
			{ "uniform": "u_radial_converge_blue",  "slider": "radial_converge_blue" },
			{ "uniform": "u_primary_mode",             "slider": "primary_color_mode" },
			{ "uniform": "u_primary_red_hue",          "slider": "primary_red_hue" },
			{ "uniform": "u_primary_red_saturation",   "slider": "primary_red_saturation" },
			{ "uniform": "u_primary_red_brightness",   "slider": "primary_red_brightness" },
			{ "uniform": "u_primary_green_hue",        "slider": "primary_green_hue" },
			{ "uniform": "u_primary_green_saturation", "slider": "primary_green_saturation" },
			{ "uniform": "u_primary_green_brightness", "slider": "primary_green_brightness" },
			{ "uniform": "u_primary_blue_hue",         "slider": "primary_blue_hue" },
			{ "uniform": "u_primary_blue_saturation",  "slider": "primary_blue_saturation" },
			{ "uniform": "u_primary_blue_brightness",  "slider": "primary_blue_brightness" },			{ "uniform": "u_y_gain",   "slider": "chroma_y_gain" },
			{ "uniform": "u_chroma_a", "slider": "chroma_a" },
			{ "uniform": "u_chroma_b", "slider": "chroma_b" },
			{ "uniform": "u_chroma_c", "slider": "chroma_c" } ],
		  "output": "internal" },
		{ "effect": "vector/vector_glow_accum", "name": "Glow Accum Narrow",
		  "_comment": "Stage 1 (narrow): one-tap seed of glow_accum. The former 9-tap effect had a hard-wired zero defocus offset here, so all nine reads sampled the same texel; this dedicated pass is visually equivalent.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "texture": "glow" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_narrow" } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "texture": "glow" } ],   "output": "glow_lo0" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ], "output": "glow_lo1" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "output": "glow_lo2" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds3", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "output": "glow_lo3" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo2" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo1" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo0" },
		{ "effect": "vector/vector_blit_add", "name": "Glow Accum Wide",
		  "_comment": "LITE Stage 2: add the broad halo reconstructed from the 1/16 floor into the half-resolution glow accumulator. Four deepest-cascade passes are omitted.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_wide" } ],
		  "output": "glow_accum" },
		{ "effect": "vector/vector_glow_combine_color_defocus", "name": "add_mglow",
		  "_comment": "Always-on final composite: unwarped/inset vector emission, dimension-correct selectable shadow mask on spherical tube coordinates, ambient plus mask-patterned monitor glow, phosphor-calibrated optical glow; writes screen_hdr directly and replaces the former extra monitor-glow pass.",
		  "input": [
			{ "sampler": "s_base",  "target": "internal" },
			{ "sampler": "s_bloom", "target": "glow_accum" },
			{ "sampler": "s_mask",  "option": "bgfx_shadow_mask", "selection": "Shadow Mask" },
			{ "sampler": "s_bezel_source", "texture": "glow" },
			{ "sampler": "s_bezel_length", "texture": "bezel_length" } ],
		  "uniforms": [
			{ "uniform": "u_defocus",                    "slider": "defocus" },
			{ "uniform": "u_vec_pincushion_x_quad",      "slider": "vector_pincushion_x_quad" },
			{ "uniform": "u_vec_pincushion_x_cubic",     "slider": "vector_pincushion_x_cubic" },
			{ "uniform": "u_vec_pincushion_y_quad",      "slider": "vector_pincushion_y_quad" },
			{ "uniform": "u_vec_pincushion_y_cubic",     "slider": "vector_pincushion_y_cubic" },
			{ "uniform": "u_glow_enable",                "slider": "analytic_glow" },
			{ "uniform": "u_shadow_mask_strength",        "slider": "shadow_mask_strength" },
			{ "uniform": "u_shadow_mask_brightboost",     "slider": "shadow_mask_brightboost" },
			{ "uniform": "u_shadow_mask_scale",           "slider": "shadow_mask_scale" },
			{ "uniform": "u_ambient_color",               "slider": "ambient_color" },
			{ "uniform": "u_ambient_level",               "slider": "ambient_level" },
			{ "uniform": "u_tube_distortion",       "slider": "tube_distortion" },
