		{ "type": "float", "name": "beam_peak_nits",    "text": "HDR Beam Peak (nits)",       "default": 600.0, "min": 80.0, "max": 2000.0, "step": 10.0, "format": "%4.0f", "screen": "vector" },
		{ "type": "float", "name": "hdr_rolloff_knee",  "text": "HDR Highlight Knee (xpeak)", "default": 1.0, "min": 0.5,  "max": 2.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "hdr_rolloff_max",   "text": "HDR Highlight Max (xpeak)",  "default": 1.0, "min": 0.5,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "hdr_sat_protect",   "text": "HDR Saturated Color Protect", "default": 1.0, "min": 0.0,  "max": 1.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "sdr_rolloff_knee",   "text": "SDR Highlight Knee (xwhite)",   "default": 1.0, "min": 0.1, "max": 4.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "sdr_rolloff_ceiling","text": "SDR Highlight Ceiling (xwhite)","default": 1.0, "min": 0.1, "max": 4.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "sdr_shadow_curve",   "text": "SDR Shadow Curve",             "default": 1.0, "min": 0.3, "max": 3.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "edr_sdr_level",       "text": "EDR SDR Level (UI/Art, macOS)",   "default": 1.0, "min": 0.1, "max": 1.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "phosphor_gamut",      "text": "Phosphor Gamut (P22, HDR)",       "default": 0.0, "min": 0.0, "max": 1.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },

		// ---- Colour (set-and-forget) ----
		{ "type": "float", "name": "color_saturation", "text": "Source Color Saturation",   "default": 1.0, "min": 0.0,  "max": 1.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },

		// ---- Geometry (set-and-forget) ----
		{ "type": "float", "name": "vector_linearity_x", "text": "Vector Linearity X (gain)", "default": 1.0, "min": 0.8,  "max": 1.2,  "step": 0.005,"format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "vector_linearity_y", "text": "Vector Linearity Y (gain)", "default": 1.0, "min": 0.8,  "max": 1.2,  "step": 0.005,"format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_x_quad",  "text": "Vector Pincushion X (Quad)",  "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_x_cubic", "text": "Vector Pincushion X (Cubic)", "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_y_quad",  "text": "Vector Pincushion Y (Quad)",  "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_y_cubic", "text": "Vector Pincushion Y (Cubic)", "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "distortion",       "text": "Quadric Distortion Amount", "default": 0.20, "max": 2.00, "min": -2.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "cubic_distortion", "text": "Cubic Distortion Amount",   "default": 0.00, "max": 2.00, "min": -2.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "distort_corner",   "text": "Distorted Corner Amount",   "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "round_corner",     "text": "Rounded Corner Amount",     "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "smooth_border",    "text": "Smooth Border Amount",      "default": 0.0, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vignetting",       "text": "Vignetting Amount",         "default": 0.80, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "reflection",       "text": "Reflection Amount",         "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },

		// ---- Ambient (set-and-forget) ----
		{ "type": "color", "name": "ambient_color",           "text": "Ambient Color ",               "default": [ 0.35, 0.45, 0.38 ], "max": [ 1.0, 1.0, 1.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "ambient_level",           "text": "Ambient Level (x0.001)",       "default": 0.0, "min": 0.0, "max": 20.0, "step": 0.5, "format": "%2.1f", "screen": "vector" },

		// ---- Utility ----
		{ "type": "intenum", "name": "pause_composite", "text": "Pause Frame Composite", "default": 0, "max": 1, "min": 0, "step": 1, "format": "%s", "screen": "vector", "strings": [ "Off", "On" ] }
	],

	"parameters": [
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{ "name": "guest",     "mode": "native", "bilinear": false, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "internal",  "mode": "native", "scale": 1, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "glow_accum", "mode": "native", "scale": 1, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "single-buffer accumulator for narrow+wide glow. Additive ADDs are safe here (single-buffer); the combined glow is then added to internal ONCE via a read+write (replace) pass, because repeated partial ADDs to the doublebuffered internal write stale pages (Wide was cancelling Narrow)." },
		{ "name": "phos_pool", "mode": "native", "scale": 1, "doublebuffer": true, "format": "RGBA16F",
		  "_comment": "phosphor pool: rgb = peak excitation colour, a = age (ms). Held + decayed by S(age). RGBA16F so age fits in alpha and colour is preserved (mono now, imager/AVG colour later)." },
		{ "name": "screen_hdr","mode": "native", "scale": 1, "doublebuffer": false, "format": "RG11B10F",
		  "_comment": "linear chain output; its presence makes the renderer present this as an HDR chain (PQ/EDR, SDR fallback)" },
		{ "name": "glow_lo0", "mode": "native", "scale": 0.5,     "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "wide local glow: the per-line glow buffer cascaded down to low-res, then upscaled+added. Bounded spread (only down to 1/16) = wide but still LOCAL (does not reach the whole screen like the bloom ladder)." },
		{ "name": "glow_lo1", "mode": "native", "scale": 0.25,    "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo2", "mode": "native", "scale": 0.125,   "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo3", "mode": "native", "scale": 0.0625,  "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo4", "mode": "native", "scale": 0.03125, "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo5", "mode": "native", "scale": 0.015625,"doublebuffer": false, "format": "RGBA16F" }
	],

	"passes": [
		{ "effect": "vector/vector_linearize", "name": "Initial Blit (linearize, screen -> guest)",
		  "input": [ { "sampler": "s_tex", "texture": "screen" } ], "output": "guest" },

		{ "effect": "hlsl/color", "name": "Color Convolution",
		  "_comment": "color_saturation slider: 0 = force grayscale (mono CRT), 1 = pass the source beam colour through to the phosphor pool (3D imager / colour sources). Provably an identity transform at saturation==1 (verified against fs_color.sc: Saturated = OutLuma + OutChroma*1 = OutTexel exactly), so that default is skipped outright.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "color_saturation", "value": 1.0 } ],
		  "uniforms": [
			{ "uniform": "u_red_ratios", "value": [ 1.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_grn_ratios", "value": [ 0.0, 1.0, 0.0, 0.0 ] },
			{ "uniform": "u_blu_ratios", "value": [ 0.0, 0.0, 1.0, 0.0 ] },
			{ "uniform": "u_offset",     "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_scale",      "value": [ 1.0, 1.0, 1.0, 0.0 ] },
			{ "uniform": "u_saturation", "slider": "color_saturation" } ],
		  "input": [ { "sampler": "s_tex", "target": "guest" } ], "output": "guest" },

		{ "effect": "hlsl/prescale", "name": "Prescale",
		  "input": [ { "sampler": "s_tex", "target": "guest" } ], "output": "internal" },

		{ "effect": "vector/vector_phosphor", "name": "Phosphor",
		  "_comment": "pool update: rgb=peak,a=age. If the fresh frame is brighter than the decayed pool the pixel re-excites (age 0), else the peak holds and age advances by dt. u_phos = (dt_ms, half, curve, total) injected by the renderer. Reads+writes phos_pool in place (doublebuffered feedback).",
		  "input": [ { "sampler": "s_prev", "target": "phos_pool" }, { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [], "output": "phos_pool" },
		{ "effect": "vector/vector_phosphor_compose", "name": "Phosphor Apply",
		  "_comment": "single compose pass replacing the former Phosphor Apply (pool emit) + NoPersist Combine + Phosphor Tint trio - two full-res passes saved, math unchanged: internal = (pool_peak * S(age) + npglow * cap_no_persist) * phosphor_color. The no-persist FBO holds line caps / short-dwell junction dots (bright while drawn, no afterimage, never fed into the glow cascade); the old pass pair's net 0.3745 x 2.67 = 0.99991 add is exactly 1.0 here (that was the intent), and u_np_gain=0 both reproduces the old disablewhen skip and guards stale np content. The entry keeps the name 'Phosphor Apply' because the renderer injects u_phos into it by name.",
		  "input": [ { "sampler": "s_tex", "target": "phos_pool" }, { "sampler": "s_np", "texture": "npglow" } ],
		  "uniforms": [
			{ "uniform": "u_np_gain",           "slider": "cap_no_persist" },
			{ "uniform": "u_line_channel_gain", "slider": "phosphor_color" } ],
		  "output": "internal" },

		{   "effect": "hlsl/defocus",
			"name": "Defocus Pass",
			"_comment": "beam-spot optical defocus (9-tap blur) on the emitted beam+pool image, BEFORE the ambient/glow composites (scattered light is added on top of the softened beam). defocus [0,0] = off (pass skipped).",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "defocus", "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_defocus", "slider": "defocus" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "vector/vector_distortion",
			"name": "Vector Pincushion Pass",
			"_comment": "asymmetric per-axis pincushion (real vector-CRT deflection-yoke nonlinearity differs between X and Y, unlike the radially-symmetric hlsl/distortion pass below) - a beam-domain distortion, applied BEFORE the ambient/glow composites (scattered light is not deflected). Complementary to, not a duplicate of, the existing Distortion Pass (monitor sphere).",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_quad",  "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_cubic", "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_y_quad",  "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_y_cubic", "value": 0.0 }
			],
			"uniforms": [
				{ "uniform": "u_vec_pincushion_x_quad",  "slider": "vector_pincushion_x_quad" },
				{ "uniform": "u_vec_pincushion_x_cubic", "slider": "vector_pincushion_x_cubic" },
				{ "uniform": "u_vec_pincushion_y_quad",  "slider": "vector_pincushion_y_quad" },
				{ "uniform": "u_vec_pincushion_y_cubic", "slider": "vector_pincushion_y_cubic" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "vector/vector_shadow_mask",
			"name": "Ambient Pass",
			"_comment": "non-excited phosphor body colour (ambient) only - a monochrome vector CRT has NO shadow mask, so the mask side of vector_shadow_mask is pinned off (strength=0 -> mask_factor=(1,1,1), provably identity for the beam; ambient_mask=0 -> flat floor). Placed BEFORE the glow composites so halation / starburst / caps / analytic glow ride on top of the body tint. Skipped entirely at the ambient_level=0 default.",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "ambient_level", "value": 0.0 }
			],
			"input": [
				{ "sampler": "s_tex",  "target":  "internal" },
				{ "sampler": "s_mask", "texture": "bgfx/chains/crt-geom/aperture_1_2_bgr.png" }
			],
			"uniforms": [
				{ "uniform": "u_shadow_mask_strength",    "value": [ 0.0 ] },
				{ "uniform": "u_shadow_mask_brightboost", "value": [ 0.0 ] },
				{ "uniform": "u_shadow_mask_scale",       "value": [ 4.0 ] },
				{ "uniform": "u_ambient_color",           "slider": "ambient_color" },
				{ "uniform": "u_ambient_level",           "slider": "ambient_level" },
				{ "uniform": "u_ambient_mask",            "value": [ 0.0 ] }
			],
			"output": "internal"
		},

		{ "effect": "vector/vector_glow_blit", "name": "Glow Accum Narrow",
		  "_comment": "Stage 1 (narrow): seed the single-buffer glow_accum with the full-res per-line glow x glow_narrow. NO clear:{} = default clear, so glow_accum starts fresh each frame (also clears it for the wide add below). Runs whenever the glow source is on (gate on analytic_glow), even if glow_narrow=0, so glow_accum is always cleared.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "texture": "glow" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_narrow" }, { "uniform": "u_glow_defocus", "value": [ 0.0 ] } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "texture": "glow" } ],   "output": "glow_lo0" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ], "output": "glow_lo1" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "output": "glow_lo2" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds3", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "output": "glow_lo3" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds4", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "output": "glow_lo4" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds5", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo4" } ], "output": "glow_lo5" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us4", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo4" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us3", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo3" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo2" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo1" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo0" },
		{ "effect": "vector/vector_blit_add", "name": "Glow Accum Wide",
		  "_comment": "Stage 2 (wide): ADD the broad far-only halo (1/64 smooth upscale from glow_lo0) into glow_accum. clear:{} PRESERVES the narrow seed above (single-buffer, so this partial ADD is safe). Result = narrow + wide in glow_accum.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_wide" } ],
		  "output": "glow_accum" },
		{ "effect": "vector/vector_bloom_apply", "name": "Glow Combine",
		  "_comment": "Add the combined glow_accum (narrow+wide) onto internal ONCE via a read+write (replace) pass: internal = internal*1 + glow_accum*1. Safe on the doublebuffered internal (reads both via samplers), unlike repeated partial ADDs which write stale pages. base_weight=1, scale=1, everything else neutral.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_base", "target": "internal" }, { "sampler": "s_bloom", "target": "glow_accum" } ],
		  "uniforms": [
			{ "uniform": "u_bloom_base_weight", "value": [ 1.0, 1.0, 1.0, 1.0 ] },
			{ "uniform": "u_bloom_scale",       "value": [ 1.0, 1.0, 1.0, 1.0 ] },
			{ "uniform": "u_bloom_overdrive",   "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_bloom_channel_gain","value": [ 1.0, 1.0, 1.0, 0.0 ] },
			{ "uniform": "u_ambient_color",     "value": [ 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_ambient_level",     "value": [ 0.0 ] },
			{ "uniform": "u_bloom_noise",       "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_time",              "parameter": "time" } ],
		  "output": "internal" },

		{ "effect": "hlsl/distortion", "name": "Distortion Pass (monitor sphere)",
		  "_comment": "CRT screen curvature / rounded corners, same hlsl/distortion used by the other vector-*.json chains. internal -> internal (cleared, so the warped corners go black). Dimension uniforms (u_screen_dims/u_target_dims/u_quad_dims/u_swap_xy) are auto-set by the chain.",
		  "disablewhen": [
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "distortion",       "value": 0.0 },
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "cubic_distortion", "value": 0.0 },
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "distort_corner",   "value": 0.0 },
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "round_corner",     "value": 0.0 },
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "smooth_border",    "value": 0.0 },
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "vignetting",       "value": 0.0 },
			{ "type": "slider", "condition": "equal", "combine": "and", "name": "reflection",       "value": 0.0 } ],
		  "uniforms": [
			{ "uniform": "u_distortion",       "slider": "distortion" },
			{ "uniform": "u_cubic_distortion", "slider": "cubic_distortion" },
			{ "uniform": "u_distort_corner",   "slider": "distort_corner" },
			{ "uniform": "u_round_corner",     "slider": "round_corner" },
			{ "uniform": "u_smooth_border",    "slider": "smooth_border" },
			{ "uniform": "u_vignetting",       "slider": "vignetting" },
			{ "uniform": "u_reflection",       "slider": "reflection" } ],
		  "input": [ { "sampler": "s_tex", "target": "internal" } ],
		  "output": "internal" },

		{ "effect": "misc/blit", "name": "Final Blit (-> screen_hdr, linear)",
		  "input": [ { "sampler": "s_tex", "target": "internal" } ], "output": "screen_hdr" }
	]
}
