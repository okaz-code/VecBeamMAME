// Vectrex phosphor-decay chain (monochrome start; colour-ready engine).
//
// RUN WITH  -bgfx_vec_beam_events 0  (full-frame mode). The model: each refresh the renderer draws the
// COMPLETE current beam list at full brightness (no time-window slicing), and a per-pixel phosphor pool
// (vector_phosphor: rgb=peak colour, a=age ms) decays whatever is no longer being redrawn along a Hill
// sigmoid S(age): S(0)=1, S(half)=0.5, reaching 0 at total ms. So a static line is re-excited every frame
// (held), and a bright fast dot stays full at its new position while its old positions fade over ~500ms.
// The pool is purely per-pixel (no t0/t1), so the same engine extends to the 3D imager and Atari AVG
// colour games later. With beam-event mode ON the renderer time-windows the points instead, which slices
// the frame and is NOT what this chain wants - keep beam events off.
{
	"name": "Vector (Vectrex Phosphor, HDR)",
	"author": "okaz",
	"screen_type": "vector",

	"sliders": [
		{ "type": "float", "name": "phosphor_half_ms",  "text": "Phosphor Half-life (ms)",   "default": 15.0, "min": 1.0, "max": 300.0,"step": 1.0,  "format": "%3.0f", "screen": "vector" },
		{ "type": "float", "name": "phosphor_curve",    "text": "Phosphor Decay Curve",      "default": 2.7, "min": 0.4,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "phosphor_total_ms", "text": "Phosphor Total (ms)",       "default": 1000.0,"min": 20.0,"max": 1500.0,"step": 10.0,"format": "%4.0f", "screen": "vector" },
		{ "type": "float", "name": "bright_threshold",  "text": "Brightness Threshold (T)", "default": 0.5, "min": 0.05, "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bright_curve",      "text": "Brightness Curve",          "default": 2.0, "min": 0.2,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "width_knee",        "text": "Width at Threshold",        "default": 0.3, "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "width_curve",       "text": "Width Curve",               "default": 1.0, "min": 0.2,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_width_min",    "text": "Beam Width Minimum",        "default": 5.0, "min": 0.1,  "max": 8.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_width_max",    "text": "Beam Width Maximum",        "default": 6.0, "min": 0.1,  "max": 24.0, "step": 0.1,  "format": "%1.1f", "screen": "vector" },
		{ "type": "float", "name": "line_sharpness",    "text": "Line Edge Sharpness",       "default": 1.0, "min": 1.0,  "max": 6.0,  "step": 0.1,  "format": "%1.1f", "screen": "vector" },
		{ "type": "float", "name": "bloom_scale",       "text": "Bloom Scale",               "default": 0.0, "min": 0.0,  "max": 2.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_base_weight", "text": "Bloom Base Weight",         "default": 1.0, "min": 0.0,  "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w0", "text": "Bloom L0 (finest)", "default": 0.3,  "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w1", "text": "Bloom L1",         "default": 0.2,  "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w2", "text": "Bloom L2",         "default": 0.12, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w3", "text": "Bloom L3",         "default": 0.08, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w4", "text": "Bloom L4",         "default": 0.06, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w5", "text": "Bloom L5",         "default": 0.05, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w6", "text": "Bloom L6",         "default": 0.04, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_w7", "text": "Bloom L7 (widest)","default": 0.03, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_bloom_strength","text": "Beam Bloom (bright=wider)",  "default": 0.2, "min": 0.0,  "max": 8.0,  "step": 0.1,  "format": "%1.1f", "screen": "vector" },
		{ "type": "float", "name": "beam_bloom_curve",  "text": "Beam Bloom Curve",          "default": 1.0, "min": 0.2,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_threshold","text": "Overload Threshold",        "default": 0.1, "min": 0.1,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_bloom",    "text": "Overload Bloom",            "default": 0.0, "min": 0.0,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "edge_defocus",      "text": "Edge Defocus",              "default": 4.0, "min": 0.0,  "max": 8.0,  "step": 0.1,  "format": "%1.1f", "screen": "vector" },
		{ "type": "float", "name": "edge_defocus_curve","text": "Edge Defocus Curve",        "default": 2.0, "min": 0.5,  "max": 4.0,  "step": 0.1,  "format": "%1.1f", "screen": "vector" },
		{ "type": "intenum", "name": "pause_composite", "text": "Pause Frame Composite", "default": 0, "max": 1, "min": 0, "step": 1, "format": "%s", "screen": "vector", "strings": [ "Off", "On" ] },
		{ "type": "float", "name": "line_cap_brightness","text": "Line Cap Brightness",        "default": 0.5, "min": 0.0,  "max": 3.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "line_cap_width",     "text": "Line Cap Width",             "default": 1.05, "min": 0.1,  "max": 4.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "phosphor_color",    "text": "Phosphor Color ",           "default": [ 0.59, 0.67, 0.64 ], "max": [ 1.0, 1.0, 1.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "phosphor_overdrive", "text": "Overdrive (white at peak)", "default": 0.3, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "overdrive_knee",     "text": "Overdrive Knee",            "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "overdrive_color",    "text": "Overdrive Color ",          "default": [ 1.0, 1.0, 1.0 ], "max": [ 1.0, 1.0, 1.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "analytic_glow",       "text": "Glow Source (per-line)",    "default": 0.2, "min": 0.0, "max": 1.0,  "step": 0.005, "format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "analytic_glow_width", "text": "Glow Source Width (px)",    "default": 8.0, "min": 1.0, "max": 160.0, "step": 1.0,  "format": "%3.0f", "screen": "vector" },
		{ "type": "float", "name": "glow_threshold",     "text": "Glow Source Threshold",     "default": 0.0, "min": 0.0,  "max": 2.0, "step": 0.02, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "glow_curve",         "text": "Glow Source Curve",         "default": 1.0, "min": 0.25, "max": 4.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "glow_narrow",        "text": "Glow Narrow (full-res)",    "default": 0.01, "min": 0.0, "max": 0.2, "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "glow_wide",          "text": "Glow Wide (low-res)",       "default": 0.005, "min": 0.0, "max": 0.2, "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "frame_smooth",       "text": "Frame Smoothing (temporal)","default": 0.0, "min": 0.0, "max": 0.95, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "tail_strength",      "text": "Comet Tail Strength",       "default": 0.02,  "min": 0.0, "max": 0.25,  "step": 0.002, "format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "tail_decay",         "text": "Comet Tail Decay (length)", "default": 0.6, "min": 0.0, "max": 0.995, "step": 0.005, "format": "%1.3f", "screen": "vector" },
		{ "type": "float", "name": "spill_threshold",    "text": "Spill Threshold",           "default": 0.6, "min": 0.1, "max": 2.0, "step": 0.02, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "spill_strength",     "text": "Spill (saturation bleed)",  "default": 0.0, "min": 0.0, "max": 4.0, "step": 0.05, "format": "%1.2f", "screen": "vector" }
	],

	"parameters": [
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{ "name": "guest",     "mode": "native", "bilinear": false, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "internal",  "mode": "native", "scale": 1, "doublebuffer": true, "format": "RG11B10F" },
		{ "name": "glow_accum", "mode": "native", "scale": 1, "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "single-buffer accumulator for narrow+wide glow. Additive ADDs are safe here (single-buffer); the combined glow is then added to internal ONCE via a read+write (replace) pass, because repeated partial ADDs to the doublebuffered internal write stale pages (Wide was cancelling Narrow)." },
		{ "name": "slow_pool", "mode": "native", "scale": 0.5, "doublebuffer": true, "format": "RGBA16F",
		  "_comment": "comet tail = slow phosphor component (P31). Additive leaky accumulator of the FRESH frame at half-res; the bilinear upscale at composite blurs it into a soft lingering tail. Separate from the fast sigmoid pool (phos_pool)." },
		{ "name": "phos_pool", "mode": "native", "scale": 1, "doublebuffer": true, "format": "RGBA16F",
		  "_comment": "phosphor pool: rgb = peak excitation colour, a = age (ms). Held + decayed by S(age). RGBA16F so age fits in alpha and colour is preserved (mono now, imager/AVG colour later)." },
		{ "name": "screen_hdr","mode": "native", "scale": 1, "doublebuffer": false, "format": "RG11B10F",
		  "_comment": "linear chain output; its presence makes the renderer present this as an HDR chain (PQ/EDR, SDR fallback)" },
		{ "name": "acc0", "mode": "native", "scale": 0.5,      "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "acc1", "mode": "native", "scale": 0.25,     "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "acc2", "mode": "native", "scale": 0.125,    "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "acc3", "mode": "native", "scale": 0.0625,   "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "acc4", "mode": "native", "scale": 0.03125,  "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "acc5", "mode": "native", "scale": 0.015625, "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "acc6", "mode": "native", "scale": 0.0078125,"doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo0", "mode": "native", "scale": 0.5,     "doublebuffer": false, "format": "RGBA16F",
		  "_comment": "wide local glow: the per-line glow buffer cascaded down to low-res, then upscaled+added. Bounded spread (only down to 1/16) = wide but still LOCAL (does not reach the whole screen like the bloom ladder)." },
		{ "name": "glow_lo1", "mode": "native", "scale": 0.25,    "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo2", "mode": "native", "scale": 0.125,   "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo3", "mode": "native", "scale": 0.0625,  "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo4", "mode": "native", "scale": 0.03125, "doublebuffer": false, "format": "RGBA16F" },
		{ "name": "glow_lo5", "mode": "native", "scale": 0.015625,"doublebuffer": false, "format": "RGBA16F" },
		{ "name": "smooth_pool", "mode": "native", "scale": 1, "doublebuffer": true, "format": "RG11B10F",
		  "_comment": "temporal smoothing (EMA) history of the final image; out = mix(cur, prev, frame_smooth). Interpolates between consecutive frames to hide the discrete step/gap of fast-moving trails." }
	],

	"passes": [
		{ "effect": "vector/vector_linearize", "name": "Initial Blit (linearize, screen -> guest)",
		  "input": [ { "sampler": "s_tex", "texture": "screen" } ], "output": "guest" },

		{ "effect": "hlsl/color", "name": "Color Convolution",
		  "_comment": "grayscale (saturation 0) for monochrome Vectrex; for colour sources this pass is removed so the beam colour reaches the phosphor pool",
		  "uniforms": [
			{ "uniform": "u_red_ratios", "value": [ 1.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_grn_ratios", "value": [ 0.0, 1.0, 0.0, 0.0 ] },
			{ "uniform": "u_blu_ratios", "value": [ 0.0, 0.0, 1.0, 0.0 ] },
			{ "uniform": "u_offset",     "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_scale",      "value": [ 1.0, 1.0, 1.0, 0.0 ] },
			{ "uniform": "u_saturation", "value": [ 0.0 ] } ],
		  "input": [ { "sampler": "s_tex", "target": "guest" } ], "output": "guest" },

		{ "effect": "hlsl/prescale", "name": "Prescale",
		  "input": [ { "sampler": "s_tex", "target": "guest" } ], "output": "internal" },

		{ "effect": "vector/vector_phosphor", "name": "Phosphor",
		  "_comment": "pool update: rgb=peak,a=age. If the fresh frame is brighter than the decayed pool the pixel re-excites (age 0), else the peak holds and age advances by dt. u_phos = (dt_ms, half, curve, total) injected by the renderer. Reads+writes phos_pool in place (doublebuffered feedback).",
		  "input": [ { "sampler": "s_prev", "target": "phos_pool" }, { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [], "output": "phos_pool" },
		{ "effect": "vector/vector_phosphor_tail", "name": "tail_accum",
		  "_comment": "comet tail (slow phosphor): slow_pool = slow_pool*tail_decay + fresh frame. Reads internal while it is still the FRESH frame (before Phosphor Apply overwrites it with the fast-decayed image), so fast and slow components both accumulate the same excitation. Half-res = blurred tail. u_tail_freeze injected by the renderer (holds the pool while paused). 0 strength = off.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "tail_strength", "value": 0.0 } ],
		  "input": [ { "sampler": "s_prev", "target": "slow_pool" }, { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [ { "uniform": "u_tail_decay", "slider": "tail_decay" } ], "output": "slow_pool" },
		{ "effect": "vector/vector_phosphor_emit", "name": "Phosphor Apply",
		  "_comment": "emit peak * S(age) from the pool into internal for the bloom/tint path",
		  "input": [ { "sampler": "s_tex", "target": "phos_pool" } ],
		  "uniforms": [], "output": "internal" },

		{ "effect": "vector/vector_downsample", "name": "ds_bloom0", "input": [ { "sampler": "s_tex", "target": "internal"   } ], "output": "bloom_lvl0" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom1", "input": [ { "sampler": "s_tex", "target": "bloom_lvl0" } ], "output": "bloom_lvl1" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom2", "input": [ { "sampler": "s_tex", "target": "bloom_lvl1" } ], "output": "bloom_lvl2" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom3", "input": [ { "sampler": "s_tex", "target": "bloom_lvl2" } ], "output": "bloom_lvl3" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom4", "input": [ { "sampler": "s_tex", "target": "bloom_lvl3" } ], "output": "bloom_lvl4" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom5", "input": [ { "sampler": "s_tex", "target": "bloom_lvl4" } ], "output": "bloom_lvl5" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom6", "input": [ { "sampler": "s_tex", "target": "bloom_lvl5" } ], "output": "bloom_lvl6" },
		{ "effect": "vector/vector_downsample", "name": "ds_bloom7", "input": [ { "sampler": "s_tex", "target": "bloom_lvl6" } ], "output": "bloom_lvl7" },

		{ "effect": "vector/vector_blit_add", "name": "seed_acc6",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl6" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w6" } ], "output": "acc6" },
		{ "effect": "vector/vector_blit_add", "name": "add_lvl7_to_acc6", "clear": {}, "input": [ { "sampler": "s_tex", "target": "bloom_lvl7" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w7" } ], "output": "acc6" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc5",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w5" } ], "output": "acc5" },
		{ "effect": "vector/vector_upsample", "name": "up_acc6_to_acc5", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc6" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc5" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc4",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w4" } ], "output": "acc4" },
		{ "effect": "vector/vector_upsample", "name": "up_acc5_to_acc4", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc4" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc3",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w3" } ], "output": "acc3" },
		{ "effect": "vector/vector_upsample", "name": "up_acc4_to_acc3", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc3" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc2",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w2" } ], "output": "acc2" },
		{ "effect": "vector/vector_upsample", "name": "up_acc3_to_acc2", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc2" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc1",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w1" } ], "output": "acc1" },
		{ "effect": "vector/vector_upsample", "name": "up_acc2_to_acc1", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc1" },
		{ "effect": "vector/vector_blit_add", "name": "seed_acc0",                  "input": [ { "sampler": "s_tex", "target": "bloom_lvl0" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_w0" } ], "output": "acc0" },
		{ "effect": "vector/vector_upsample", "name": "up_acc1_to_acc0", "clear": {}, "input": [ { "sampler": "s_tex", "target": "acc1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "acc0" },

		{ "effect": "vector/vector_bloom_apply", "name": "Bloom Apply",
		  "input": [ { "sampler": "s_base", "target": "internal" }, { "sampler": "s_bloom", "target": "acc0" } ],
		  "uniforms": [
			{ "uniform": "u_bloom_base_weight", "slider":    "bloom_base_weight" },
			{ "uniform": "u_bloom_scale",       "slider":    "bloom_scale" },
			{ "uniform": "u_bloom_overdrive",   "value":     [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_bloom_channel_gain","value":     [ 1.0, 1.0, 1.0, 0.0 ] },
			{ "uniform": "u_ambient_color",     "value":     [ 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_ambient_level",     "value":     [ 0.0 ] },
			{ "uniform": "u_time",              "parameter": "time" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_blit_add", "name": "tail_add",
		  "_comment": "composite the slow comet tail: ADD slow_pool * tail_strength onto internal (half-res -> bilinear upscale = soft wide tail), AFTER bloom so it is not re-bloomed, BEFORE tint so it gets the phosphor colour. clear:{} preserves the bloomed image. Independent of bloom_scale.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "tail_strength", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "target": "slow_pool" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "tail_strength" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_color_mix", "name": "Phosphor Tint",
		  "input": [ { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [
			{ "uniform": "u_red_mix",           "value":  [ 1.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_green_mix",         "value":  [ 0.0, 1.0, 0.0, 0.0 ] },
			{ "uniform": "u_blue_mix",          "value":  [ 0.0, 0.0, 1.0, 0.0 ] },
			{ "uniform": "u_line_channel_gain", "slider": "phosphor_color" },
			{ "uniform": "u_phosphor_overdrive",      "slider": "phosphor_overdrive" },
			{ "uniform": "u_phosphor_overdrive_knee", "slider": "overdrive_knee" },
			{ "uniform": "u_overdrive_color",         "slider": "overdrive_color" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_spill", "name": "Saturation Spill",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "spill_strength", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [
			{ "uniform": "u_spill_threshold", "slider": "spill_threshold" },
			{ "uniform": "u_spill_strength",  "slider": "spill_strength" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_glow_blit", "name": "Glow Accum Narrow",
		  "_comment": "Stage 1 (narrow): seed the single-buffer glow_accum with the full-res per-line glow x glow_narrow. NO clear:{} = default clear, so glow_accum starts fresh each frame (also clears it for the wide add below). Runs whenever the glow source is on (gate on analytic_glow), even if glow_narrow=0, so glow_accum is always cleared.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "texture": "glow" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_narrow" }, { "uniform": "u_glow_defocus", "value": [ 0.0 ] } ],
		  "output": "glow_accum" },

		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "texture": "glow" } ],   "output": "glow_lo0" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ], "output": "glow_lo1" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "output": "glow_lo2" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds3", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "output": "glow_lo3" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds4", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "output": "glow_lo4" },
		{ "effect": "vector/vector_downsample", "name": "wide_glow_ds5", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo4" } ], "output": "glow_lo5" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us4", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo4" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us3", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo3" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us2", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo2" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us1", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo1" },
		{ "effect": "vector/vector_upsample", "name": "wide_glow_us0", "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ], "input": [ { "sampler": "s_tex", "target": "glow_lo1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "value": [ 1.0 ] } ], "output": "glow_lo0" },
		{ "effect": "vector/vector_blit_add", "name": "Glow Accum Wide",
		  "_comment": "Stage 2 (wide): ADD the broad far-only halo (1/64 smooth upscale from glow_lo0) into glow_accum. clear:{} PRESERVES the narrow seed above (single-buffer, so this partial ADD is safe). Result = narrow + wide in glow_accum.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "glow_wide", "value": 0.0 } ],
		  "clear": {},
		  "input": [ { "sampler": "s_tex", "target": "glow_lo0" } ],
		  "uniforms": [ { "uniform": "u_blit_intensity", "slider": "glow_wide" } ],
		  "output": "glow_accum" },
		{ "effect": "vector/vector_bloom_apply", "name": "Glow Combine",
		  "_comment": "Add the combined glow_accum (narrow+wide) onto internal ONCE via a read+write (replace) pass: internal = internal*1 + glow_accum*1. Safe on the doublebuffered internal (reads both via samplers), unlike repeated partial ADDs which write stale pages. base_weight=1, scale=1, everything else neutral.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "analytic_glow", "value": 0.0 } ],
		  "input": [ { "sampler": "s_base", "target": "internal" }, { "sampler": "s_bloom", "target": "glow_accum" } ],
		  "uniforms": [
			{ "uniform": "u_bloom_base_weight", "value": [ 1.0, 1.0, 1.0, 1.0 ] },
			{ "uniform": "u_bloom_scale",       "value": [ 1.0, 1.0, 1.0, 1.0 ] },
			{ "uniform": "u_bloom_overdrive",   "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_bloom_channel_gain","value": [ 1.0, 1.0, 1.0, 0.0 ] },
			{ "uniform": "u_ambient_color",     "value": [ 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_ambient_level",     "value": [ 0.0 ] },
			{ "uniform": "u_bloom_noise",       "value": [ 0.0, 0.0, 0.0, 0.0 ] },
			{ "uniform": "u_time",              "parameter": "time" } ],
		  "output": "internal" },

		{ "effect": "vector/vector_temporal_lp", "name": "Frame Smooth",
		  "_comment": "temporal low-pass (EMA) of the final image: out = mix(cur, prev, frame_smooth). Blends consecutive frames so a fast trail's discrete per-frame copies interpolate into a smooth streak (hides the step) at the cost of some extra lag. 0 = off.",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "frame_smooth", "value": 0.0 } ],
		  "input": [ { "sampler": "s_prev", "target": "smooth_pool" }, { "sampler": "s_tex", "target": "internal" } ],
		  "uniforms": [ { "uniform": "u_smooth_k", "slider": "frame_smooth" } ],
		  "output": "smooth_pool" },
		{ "effect": "misc/blit", "name": "Frame Smooth Writeback",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "frame_smooth", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "smooth_pool" } ], "output": "internal" },

		{ "effect": "misc/blit", "name": "Final Blit (-> screen_hdr, linear)",
		  "input": [ { "sampler": "s_tex", "target": "internal" } ], "output": "screen_hdr" }
	]
}
