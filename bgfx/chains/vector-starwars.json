// Star Wars 等のビーム飽和を再現する Color 版派生 chain。
//   Color 版に加えて overload_* (6 slider、drawbgfx の put_solid_line が読みビーム飽和を再現)
//   と mglow_* (5 slider) + add_mglow pass (モニタ周辺発光、Bloom Apply 後に合成) を持つ。
{
	"name": "Vector (Star Wars)",
	"author": "Ryan Holtz & ImJezze (HLSL 原作) / okaz (vector adaptation)",
	"screen_type": "vector",

	"sliders": [
		{ "type": "intenum", "name": "adjustments", "text": "Enable Adjustments", "default": 1, "max": 1, "min": 0, "step": 1, "format": "%s", "screen": "vector", "strings": [ "Off", "On" ] },
		{ "type": "float", "name": "beam_width_min",      "text": "Beam Width Minimum",     "default": 1.0,  "min": 1.0, "max": 5.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_width_max",      "text": "Beam Width Maximum",     "default": 1.5,  "min": 1.0, "max": 10.0, "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_dot_size_min",   "text": "Beam Dot Size Min",   "default": 0.1,  "min": 0.0,  "max": 8.0,  "step": 0.1,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_dot_size_max",   "text": "Beam Dot Size Max",   "default": 0.5,  "min": 0.0,  "max": 16.0, "step": 0.1,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "beam_dot_size_curve", "text": "Beam Dot Size Curve", "default": 0.0,  "min": -1.0, "max": 1.0,  "step": 0.05, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_fake_flicker", "text": "Vector Fake Flicker (ini)", "default": 0.15, "min": 0.0, "max": 1.0,  "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "color", "name": "red_ratios", "text": "Red Output from ",   "default": [ 1.00, 0.00, 0.00 ], "max": [ 2.00, 2.00, 2.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "grn_ratios", "text": "Green Output from ", "default": [ 0.00, 1.00, 0.00 ], "max": [ 2.00, 2.00, 2.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "blu_ratios", "text": "Blue Output from ",  "default": [ 0.00, 0.00, 1.00 ], "max": [ 2.00, 2.00, 2.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "offset",     "text": "Signal Offset, ",    "default": [ 0.00, 0.00, 0.00 ], "max": [ 2.00, 2.00, 2.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "scale",      "text": "Signal Scale, ",     "default": [ 1.00, 1.00, 1.00 ], "max": [ 2.00, 2.00, 2.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "saturation", "text": "Color Saturation",   "default": 1.00,                 "max": 4.00,                 "min": 0.00,                 "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "vec2", "name": "converge_red",          "text": "Red Linear Convergence, ",          "default": [ 0.0, 0.0 ], "max": [ 10.0, 10.0 ], "min": [ -10.0, -10.0 ], "step": 0.1, "format": "%2.1f", "screen": "vector" },
		{ "type": "vec2", "name": "converge_green",        "text": "Green Linear Convergence, ",        "default": [ 0.0, 0.0 ], "max": [ 10.0, 10.0 ], "min": [ -10.0, -10.0 ], "step": 0.1, "format": "%2.1f", "screen": "vector" },
		{ "type": "vec2", "name": "converge_blue",         "text": "Blue Linear Convergence, ",         "default": [ 0.0, 0.0 ], "max": [ 10.0, 10.0 ], "min": [ -10.0, -10.0 ], "step": 0.1, "format": "%2.1f", "screen": "vector" },
		{ "type": "vec2", "name": "radial_converge_red",   "text": "Red Radial Convergence, ",          "default": [ 0.0, 0.0 ], "max": [ 0.1, 0.1 ], "min": [ -0.1, -0.1 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "vec2", "name": "radial_converge_green", "text": "Green Radial Convergence, ",        "default": [ 0.0, 0.0 ], "max": [ 0.1, 0.1 ], "min": [ -0.1, -0.1 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "vec2", "name": "radial_converge_blue",  "text": "Blue Radial Convergence, ",         "default": [ 0.0, 0.0 ], "max": [ 0.1, 0.1 ], "min": [ -0.1, -0.1 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },

		{ "type": "vec2", "name": "defocus", "text": "Defocus, ", "default": [ 0.9, 0.9 ], "max": [ 2.0, 2.0 ], "min": [ 0.0, 0.0 ], "step": 0.1, "format": "%1.1f", "screen": "vector" },
		{ "type": "float", "name": "overscan_x", "text": "Overscan Zoom X", "default": 1.0, "min": 0.33, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "overscan_y", "text": "Overscan Zoom Y", "default": 1.0, "min": 0.33, "max": 1.0, "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "float", "name": "shadow_mask_strength",    "text": "Shadow Mask Strength",          "default": 0.7,  "min": 0.0,  "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "shadow_mask_brightboost", "text": "Shadow Mask Brightness Boost",  "default": 0.0,  "min": 0.0,  "max": 2.0,  "step": 0.05,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "shadow_mask_scale",       "text": "Shadow Mask Scale (px @1080p)", "default": 4.0,  "min": 1.0,  "max": 8.0,  "step": 0.5,   "format": "%2.1f", "screen": "vector" },

		{ "type": "color", "name": "floor", "text": "Signal Floor, ",    "default": [ 0.00, 0.00, 0.00 ], "max": [ 1.00, 1.00, 1.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "color", "name": "power", "text": "Signal Exponent, ", "default": [ 1.00, 1.00, 1.00 ], "max": [ 4.00, 4.00, 4.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "intenum", "name": "chroma_mode", "text": "Color Mode", "default": 3, "max": 3, "min": 1, "step": 1, "format": "%s", "screen": "vector", "strings": [ " ", "Monochrome", "Dichrome", "Trichrome" ] },
		{ "type": "color",   "name": "chroma_conversion_gain", "text": "Chroma Conversion Gain, ", "default": [ 0.299, 0.587, 0.114 ], "max": [ 1.0, 1.0, 1.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.0001, "format": "%1.4f", "screen": "vector" },
		{ "type": "vec2",    "name": "chroma_a", "text": "Phosphor A Chromaticity ", "default": [ 0.630, 0.340 ], "max": [ 1.0, 1.0 ], "min": [ 0.0, 0.0 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "vec2",    "name": "chroma_b", "text": "Phosphor B Chromaticity ", "default": [ 0.310, 0.595 ], "max": [ 1.0, 1.0 ], "min": [ 0.0, 0.0 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "vec2",    "name": "chroma_c", "text": "Phosphor C Chromaticity ", "default": [ 0.155, 0.070 ], "max": [ 1.0, 1.0 ], "min": [ 0.0, 0.0 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "color",   "name": "chroma_y_gain", "text": "Phosphor Gain, ", "default": [ 0.2124, 0.7011, 0.0866 ], "max": [ 1.0, 1.0, 1.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.0001, "format": "%1.4f", "screen": "vector" },

		{ "type": "color", "name": "phosphor", "text": "Phosphor Persistence, ",  "default": [ 0.40, 0.40, 0.40 ], "max": [ 1.00, 1.00, 1.00 ], "min": [ 0.00, 0.00, 0.00 ], "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "float", "name": "bloom_scale",          "text": "Bloom Scale",                       "default": 1.20, "max": 2.00, "min": 0.00, "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "color", "name": "bloom_overdrive",      "text": "Bloom Overdrive, ",                 "default": [ 0.30, 0.29, 0.15 ], "max": [ 2.0, 2.0, 2.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.001, "format": "%1.3f", "screen": "vector" },
		{ "type": "color", "name": "bloom_channel_gain",   "text": "Bloom Channel Gain, ",              "default": [ 0.9, 0.8, 1.3 ], "max": [ 4.0, 4.0, 4.0 ], "min": [ 0.0, 0.0, 0.0 ], "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_base_weight",    "text": "Bloom Base Weight (Level 0)",       "default": 1.00, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl0_weight",    "text": "Bloom Level 1 Weight (1/2)",        "default": 0.50, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl1_weight",    "text": "Bloom Level 2 Weight (1/4)",        "default": 0.40, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl2_weight",    "text": "Bloom Level 3 Weight (1/8)",        "default": 0.30, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl3_weight",    "text": "Bloom Level 4 Weight (1/16)",       "default": 0.20, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl4_weight",    "text": "Bloom Level 5 Weight (1/32)",       "default": 0.25, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl5_weight",    "text": "Bloom Level 6 Weight (1/64)",       "default": 0.20, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl6_weight",    "text": "Bloom Level 7 Weight (1/128)",      "default": 0.25, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "bloom_lvl7_weight",    "text": "Bloom Level 8 Weight (1/256)",      "default": 0.30, "max": 1.00, "min": 0.00, "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "halo_smoothness",      "text": "Halo Smoothness",                   "default": 0.50, "max": 2.00, "min": 0.00, "step": 0.05,  "format": "%2.2f", "screen": "vector" },

		{ "type": "float", "name": "vector_flicker",              "text": "Vector CRT Flicker",            "default": 0.25, "max": 1.00, "min": 0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "float", "name": "overload_sigmoid_k",          "text": "Overload Sigmoid K",            "default": 0.0,  "min": -1.0, "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_threshold",          "text": "Overload Threshold",            "default": 0.7,  "min": 0.01, "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_width_curve_low",    "text": "Overload Width Curve Low",      "default": 0.8,  "min": -1.0, "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_width_curve_high",   "text": "Overload Width Curve High",     "default": 0.0,  "min": -1.0, "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_width_max",          "text": "Overload Max Width",            "default": 5.0,  "min": 1.0,  "max": 10.0, "step": 0.05,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "overload_softness",           "text": "Overload Softness",             "default": 2.0,  "min": 0.0,  "max": 2.0,  "step": 0.05,  "format": "%2.2f", "screen": "vector" },

		{ "type": "float", "name": "mglow_threshold",             "text": "Monitor Glow Threshold",        "default": 0.7,  "min": 0.0,  "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "mglow_min_distance",          "text": "Monitor Glow Off-screen Dist",  "default": 0.30, "min": 0.0,  "max": 0.5,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "mglow_coefficient",           "text": "Monitor Glow Coefficient",      "default": 0.3,  "min": 0.0,  "max": 10.0, "step": 0.05,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "mglow_brightness",            "text": "Monitor Glow Brightness",       "default": 0.5,  "min": 0.0,  "max": 2.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "mglow_center_edge_diff",      "text": "Monitor Glow Center-Edge Diff", "default": 0.5,  "min": 0.0,  "max": 1.0,  "step": 0.01,  "format": "%2.2f", "screen": "vector" },

		{ "type": "float", "name": "line_cap_size",               "text": "Line Cap Size (px @1080p)",     "default": 2.0,  "min": 0.0,  "max": 20.0, "step": 0.5,   "format": "%2.1f", "screen": "vector" },
		{ "type": "float", "name": "line_cap_min_size",         "text": "Line Cap Min Size (px @1080p)", "default": 0.0,  "min": 0.0,  "max": 20.0, "step": 0.5,   "format": "%2.1f", "screen": "vector" },
		{ "type": "float", "name": "line_cap_intensity_curve",  "text": "Line Cap Intensity Curve",      "default": 0.0,  "min": 0.0,  "max": 4.0,  "step": 0.05,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "line_cap_brightness",         "text": "Line Cap Brightness",           "default": 1.0,  "min": 1.0,  "max": 3.0,  "step": 0.05,  "format": "%2.2f", "screen": "vector" },
		{ "type": "float", "name": "line_point_threshold",        "text": "Line Point Threshold",          "default": 2.0,  "min": 0.0,  "max": 10.0, "step": 0.5,   "format": "%2.1f", "screen": "vector" },

		{ "type": "float", "name": "vector_length_scale",         "text": "Vector Length Fade Scale",      "default": 0.7,  "min": 0.0,  "max": 1.0,  "step": 0.01,  "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_length_ratio",         "text": "Vector Length Fade Ratio",      "default": 0.5,  "min": 0.05, "max": 1.5,  "step": 0.01,  "format": "%1.2f", "screen": "vector" },

		{ "type": "float", "name": "distortion",       "text": "Quadric Distortion Amount", "default": 0.20, "max": 2.00, "min": -2.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "cubic_distortion", "text": "Cubic Distortion Amount",   "default": 0.00, "max": 2.00, "min": -2.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "distort_corner",   "text": "Distorted Corner Amount",   "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "round_corner",     "text": "Rounded Corner Amount",     "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "smooth_border",    "text": "Smooth Border Amount",      "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vignetting",       "text": "Vignetting Amount",         "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "reflection",       "text": "Reflection Amount",         "default": 0.00, "max": 2.00, "min":  0.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },

		{ "type": "float", "name": "vector_pincushion_x_quad",  "text": "Vector Pincushion X (Quad)",  "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_x_cubic", "text": "Vector Pincushion X (Cubic)", "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_y_quad",  "text": "Vector Pincushion Y (Quad)",  "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" },
		{ "type": "float", "name": "vector_pincushion_y_cubic", "text": "Vector Pincushion Y (Cubic)", "default": 0.00, "max": 1.00, "min": -1.00, "step": 0.01, "format": "%1.2f", "screen": "vector" }
	],

	"parameters": [
		{ "name": "jitter", "type": "frame", "period": 2 },
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],

	"targets": [
		{   "name": "guest",
			"mode": "native",
			"bilinear": false,
			"doublebuffer": true
		},
		{   "name": "internal",
			"_comment": "scale 1。全フルスクリーン pass を window と同解像度で処理する",
			"mode": "native",
			"scale": 1,
			"doublebuffer": true
		},
		{   "name": "previous",
			"mode": "native",
			"scale": 1,
			"doublebuffer": true
		},
		{   "name": "bloom_sum",
			"_comment": "bloom_sum は RGBA16F (float)。BGRA8 では bloom グラデに 8bit 量子化ディザが出るため float で累積する。scale 1 でも帯域は実用範囲",
			"mode": "native",
			"scale": 1,
			"doublebuffer": false,
			"format": "RGBA16F"
		},
		{   "name": "post_bloom",
			"mode": "native",
			"scale": 1,
			"doublebuffer": false
		}
	],

	"passes": [
		{   "effect": "misc/blit",
			"name": "Initial Blit (screen → guest)",
			"input": [
				{ "sampler": "s_tex", "texture": "screen" }
			],
			"output": "guest"
		},
		{   "effect": "hlsl/color",
			"name": "Color Convolution",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_red_ratios", "slider": "red_ratios" },
				{ "uniform": "u_grn_ratios", "slider": "grn_ratios" },
				{ "uniform": "u_blu_ratios", "slider": "blu_ratios" },
				{ "uniform": "u_offset",     "slider": "offset"     },
				{ "uniform": "u_scale",      "slider": "scale"      },
				{ "uniform": "u_saturation", "slider": "saturation" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "guest" }
			],
			"output": "guest"
		},
		{   "effect": "hlsl/prescale",
			"name": "Prescale",
			"input": [
				{ "sampler": "s_tex", "target": "guest" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/deconverge",
			"name": "Deconvergence",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",           "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_red",          "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_green",        "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "converge_blue",         "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_red",   "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_green", "value": [ 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "radial_converge_blue",  "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_converge_red",          "slider": "converge_red"   },
				{ "uniform": "u_converge_green",        "slider": "converge_green" },
				{ "uniform": "u_converge_blue",         "slider": "converge_blue"  },
				{ "uniform": "u_radial_converge_red",   "slider": "radial_converge_red"   },
				{ "uniform": "u_radial_converge_green", "slider": "radial_converge_green" },
				{ "uniform": "u_radial_converge_blue",  "slider": "radial_converge_blue"  }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/defocus",
			"name": "Defocus Pass",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or", "name": "adjustments", "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "or", "name": "defocus",     "value": [ 0, 0 ] }
			],
			"uniforms": [
				{ "uniform": "u_defocus", "slider": "defocus" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/post",
			"name": "Non-Bloom Post Pass",
			"_comment": "shadow mask は別 pass (sw_shadow_mask) で処理するため、HLSL post の shadow 系 uniform は literal 0 に固定。本 pass は floor / power / chroma のみ担当する",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",    "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "floor",          "value": [ 0, 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "power",          "value": [ 0, 0, 0 ] },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "chroma_mode",    "value": 3 }
			],
			"uniforms": [
				{ "uniform": "u_shadow_tile_mode",       "value":  [ 0.0 ] },
				{ "uniform": "u_shadow_alpha",           "value":  [ 0.0 ] },
				{ "uniform": "u_shadow_count",           "value":  [ 1.0, 1.0 ] },
				{ "uniform": "u_shadow_uv",              "value":  [ 0.0, 0.0 ] },
				{ "uniform": "u_shadow_uv_offset",       "value":  [ 0.0, 0.0 ] },
				{ "uniform": "u_humbar_alpha",           "value":  [ 0.0 ] },
				{ "uniform": "u_humbar_hertz_rate",      "value":  [ 0.0 ] },
				{ "uniform": "u_floor",                  "slider": "floor" },
				{ "uniform": "u_power",                  "slider": "power" },
				{ "uniform": "u_chroma_mode",            "slider": "chroma_mode" },
				{ "uniform": "u_conversion_gain",        "slider": "chroma_conversion_gain" },
				{ "uniform": "u_time",                   "parameter": "time" }
			],
			"input": [
				{ "sampler": "s_tex",    "target": "internal" },
				{ "sampler": "s_shadow", "option": "bgfx_shadow_mask", "selection": "Shadow Mask" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/phosphor",
			"name": "Phosphor Decay",
			"_comment": "本 pass の input は internal (lines のみ)。phosphor persistence は lines のみで蓄積する (bloom は散乱光で本来 instantaneous)。phosphor=[0,0,0] でも shader 内は identity (PrevY*0+CurrY=CurrY)",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_passthrough", "value": [ 0 ] },
				{ "uniform": "u_phosphor",    "slider": "phosphor" }
			],
			"input": [
				{ "sampler": "s_tex",  "target": "internal" },
				{ "sampler": "s_prev", "target": "previous" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/phosphor",
			"name": "Phosphor Store",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_passthrough", "value": [ 1 ] },
				{ "uniform": "u_phosphor",    "slider": "phosphor" }
			],
			"input": [
				{ "sampler": "s_tex",  "target": "internal" },
				{ "sampler": "s_prev", "target": "internal" }
			],
			"output": "previous"
		},
		{
			"effect": "hlsl/chroma",
			"name": "Phosphor Chromaticity Conversion",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "name": "adjustments", "value": 0 }
			],
			"uniforms": [
				{ "uniform": "u_y_gain",   "slider": "chroma_y_gain" },
				{ "uniform": "u_chroma_a", "slider": "chroma_a" },
				{ "uniform": "u_chroma_b", "slider": "chroma_b" },
				{ "uniform": "u_chroma_c", "slider": "chroma_c" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "sw_vector_distortion",
			"name": "Vector Pincushion Pass",
			"_comment": "pincushion を shadow mask より先に適用する。電子ビーム偏向 (pincushion) で蛍光面に描画し、その上に固定 mask grid が乗る物理順序に合わせる (逆順だと mask grid 自体が歪む)",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",              "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_quad",  "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_x_cubic", "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_y_quad",  "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vector_pincushion_y_cubic", "value": 0.0 }
			],
			"uniforms": [
				{ "uniform": "u_vec_pincushion_x_quad",  "slider": "vector_pincushion_x_quad" },
				{ "uniform": "u_vec_pincushion_x_cubic", "slider": "vector_pincushion_x_cubic" },
				{ "uniform": "u_vec_pincushion_y_quad",  "slider": "vector_pincushion_y_quad" },
				{ "uniform": "u_vec_pincushion_y_cubic", "slider": "vector_pincushion_y_cubic" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "sw_shadow_mask",
			"name": "Shadow Mask Pass",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",          "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "shadow_mask_strength", "value": 0.0 }
			],
			"input": [
				{ "sampler": "s_tex",  "target":  "internal" },
				{ "sampler": "s_mask", "texture": "bgfx/chains/crt-geom/aperture_1_2_bgr.png" }
			],
			"uniforms": [
				{ "uniform": "u_shadow_mask_strength",    "slider": "shadow_mask_strength" },
				{ "uniform": "u_shadow_mask_brightboost", "slider": "shadow_mask_brightboost" },
				{ "uniform": "u_shadow_mask_scale",       "slider": "shadow_mask_scale" }
			],
			"output": "internal"
		},

		{ "_comment": "8 段 0.5x bloom。bloom 源 = mask 適用済み internal。bloom_lvl0..7 (window/2..window/256) は C++ 側で生成。sw_downsample (4-tap) で連続 0.5x 縮小し、sw_blit_add で bloom_sum に重み付き加算する",
		  "effect": "sw_downsample", "name": "ds_bloom0", "input": [ { "sampler": "s_tex", "target": "internal"   } ], "output": "bloom_lvl0" },
		{ "effect": "sw_downsample", "name": "ds_bloom1", "input": [ { "sampler": "s_tex", "target": "bloom_lvl0" } ], "output": "bloom_lvl1" },
		{ "effect": "sw_downsample", "name": "ds_bloom2", "input": [ { "sampler": "s_tex", "target": "bloom_lvl1" } ], "output": "bloom_lvl2" },
		{ "effect": "sw_downsample", "name": "ds_bloom3", "input": [ { "sampler": "s_tex", "target": "bloom_lvl2" } ], "output": "bloom_lvl3" },
		{ "effect": "sw_downsample", "name": "ds_bloom4", "input": [ { "sampler": "s_tex", "target": "bloom_lvl3" } ], "output": "bloom_lvl4" },
		{ "effect": "sw_downsample", "name": "ds_bloom5", "input": [ { "sampler": "s_tex", "target": "bloom_lvl4" } ], "output": "bloom_lvl5" },
		{ "effect": "sw_downsample", "name": "ds_bloom6", "input": [ { "sampler": "s_tex", "target": "bloom_lvl5" } ], "output": "bloom_lvl6" },
		{ "effect": "sw_downsample", "name": "ds_bloom7", "input": [ { "sampler": "s_tex", "target": "bloom_lvl6" } ], "output": "bloom_lvl7" },

		{ "effect": "sw_blit_add", "name": "add_bloom_lvl0",                "input": [ { "sampler": "s_tex", "target": "bloom_lvl0" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl0_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl1", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl1" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl1_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl2", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl2" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl2_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl3", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl3" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl3_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl4", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl4" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl4_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl5", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl5" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl5_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl6", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl6" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl6_weight" } ], "output": "bloom_sum" },
		{ "effect": "sw_blit_add", "name": "add_bloom_lvl7", "clear": {},   "input": [ { "sampler": "s_tex", "target": "bloom_lvl7" } ], "uniforms": [ { "uniform": "u_blit_intensity", "slider": "bloom_lvl7_weight" } ], "output": "bloom_sum" },

		{ "effect": "sw_blur", "name": "halo_smooth_h",
		  "_comment": "bloom_sum を halo_smoothness 幅で追加ガウシアン blur する。halo_smoothness=0 で skip",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "halo_smoothness", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "bloom_sum" } ],
		  "uniforms": [ { "uniform": "u_blur_dir", "value": [ 1.0, 0.0, 0.0, 0.0 ] }, { "uniform": "u_blur_width", "slider": "halo_smoothness" }, { "uniform": "u_blur_strength", "value": [ 1.0, 1.0, 1.0, 0.0 ] } ],
		  "output": "bloom_smooth_tmp" },
		{ "effect": "sw_blur", "name": "halo_smooth_v",
		  "disablewhen": [ { "type": "slider", "condition": "equal", "name": "halo_smoothness", "value": 0.0 } ],
		  "input": [ { "sampler": "s_tex", "target": "bloom_smooth_tmp" } ],
		  "uniforms": [ { "uniform": "u_blur_dir", "value": [ 0.0, 1.0, 0.0, 0.0 ] }, { "uniform": "u_blur_width", "slider": "halo_smoothness" }, { "uniform": "u_blur_strength", "value": [ 1.0, 1.0, 1.0, 0.0 ] } ],
		  "output": "bloom_sum" },

		{ "effect": "sw_bloom_apply", "name": "Bloom Apply",
		  "_comment": "bloom は shadow mask の後段で合成する。物理順序 (ビーム → mask filtering → 発光 → 光散乱(bloom) → glass) に従い、mask は入射側のみ作用し、出射側の散乱光 (bloom) は mask の影響を受けない",
		  "input": [ { "sampler": "s_base", "target": "internal" }, { "sampler": "s_bloom", "target": "bloom_sum" } ],
		  "uniforms": [
		    { "uniform": "u_bloom_base_weight", "slider":    "bloom_base_weight" },
		    { "uniform": "u_bloom_scale",       "slider":    "bloom_scale" },
		    { "uniform": "u_bloom_overdrive",   "slider":    "bloom_overdrive" },
		    { "uniform": "u_bloom_channel_gain","slider":    "bloom_channel_gain" },
		    { "uniform": "u_time",              "parameter": "time" }
		  ],
		  "output": "post_bloom" },

		{ "effect": "sw_monitor_glow", "name": "add_mglow", "clear": {},
		  "_comment": "monitor glow を Bloom Apply の後段で合成する (post_bloom の self-RW だが point sample なので安全)",
		  "input": [ { "sampler": "s_tex", "target": "post_bloom" } ],
		  "uniforms": [
		    { "uniform": "u_mglow_brightness", "slider": "mglow_brightness" },
		    { "uniform": "u_mglow_edge_diff",  "slider": "mglow_center_edge_diff" }
		  ],
		  "output": "post_bloom" },

		{   "effect": "misc/blit",
			"name": "Pre-Distortion Blit (post_bloom → internal)",
			"_comment": "post_bloom は single-buffer のため、Distortion (warped 座標を sample) が同一 target を read/write するとレース状態になる。post_bloom の結果を double-buffered internal にコピーしてから Distortion + Final Blit を internal で行う",
			"input": [
				{ "sampler": "s_tex", "target": "post_bloom" }
			],
			"output": "internal"
		},
		{   "effect": "hlsl/distortion",
			"name": "Distortion Pass",
			"disablewhen": [
				{ "type": "slider", "condition": "equal", "combine": "or",  "name": "adjustments",      "value": 0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "distortion",       "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "cubic_distortion", "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "distort_corner",   "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "round_corner",     "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "smooth_border",    "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "vignetting",       "value": 0.0 },
				{ "type": "slider", "condition": "equal", "combine": "and", "name": "reflection",       "value": 0.0 }
			],
			"uniforms": [
				{ "uniform": "u_distortion",       "slider": "distortion" },
				{ "uniform": "u_cubic_distortion", "slider": "cubic_distortion" },
				{ "uniform": "u_distort_corner",   "slider": "distort_corner" },
				{ "uniform": "u_round_corner",     "slider": "round_corner" },
				{ "uniform": "u_smooth_border",    "slider": "smooth_border" },
				{ "uniform": "u_vignetting",       "slider": "vignetting" },
				{ "uniform": "u_reflection",       "slider": "reflection" }
			],
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "internal"
		},
		{   "effect": "misc/blit",
			"name": "Final Blit",
			"input": [
				{ "sampler": "s_tex", "target": "internal" }
			],
			"output": "output"
		}
	]
}
